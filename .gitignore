# Build output
bin/
obj/
publish/
*.user
*.suo
.vs/
.vscode/
.idea/

# Test output
TestResults/
*.trx
*.coverage
*.coveragexml

# What ZeyoCut writes: projects, renders, exports, backups, logs and background jobs
# (anchored where a name could match a source folder, such as src/ZeyoCut.Render/Jobs)
/projects/
/logs/
/jobs/
renders/
exports/
examples/**/backups/

# Local configuration and secrets
appsettings.*.json
*.local.json
.env
.env.*
*.pfx
*.pem
*.key

# Downloaded models and media (never committed)
*.onnx
ggml-*.bin
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.avi

# Fonts: Windows fonts must never be committed
*.ttf
*.otf
*.ttc

# Release packages
*.zip
*.mcpb

# Website build
site/

# OS files
Thumbs.db
Desktop.ini
.DS_Store
