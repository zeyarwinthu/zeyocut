<Window x:Class="ZeyoCut.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeyoCut.Editor"
        Title="ZeyoCut Editor" Width="1400" Height="860" MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="ListButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="12,8">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <local:ColorSwatch x:Key="Swatch" />
    <DataTemplate x:Key="TitleCardTemplate">
      <StackPanel Margin="2" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Name}">
        <Grid Height="124">
          <Border CornerRadius="8" Background="{StaticResource ControlBrush}" />
          <Image Source="{Binding Picture}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
        <TextBlock Margin="4,7,4,2" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Medium" /><Run Text=" · " Foreground="{StaticResource SecondaryTextBrush}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" />
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Tip}" />
    </Style>

    <Style x:Key="BoxUnit" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="BoxPrefix" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Keyed}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <local:InspectorTemplates x:Key="InspectorTemplates">
      <local:InspectorTemplates.Section>
        <DataTemplate>
          <TextBlock Text="{Binding Label}" Style="{StaticResource PanelTitle}" Margin="0,16,0,6" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </local:InspectorTemplates.Section>
      <local:InspectorTemplates.Info>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Info>
      <local:InspectorTemplates.Number>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <Grid Grid.Column="1">
              <TextBox Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" Padding="8,5,28,5" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" GotKeyboardFocus="OnFieldEntered" />
              <TextBlock Text="{Binding Unit}" Style="{StaticResource BoxUnit}" />
            </Grid>
            <Button Grid.Column="2" Style="{StaticResource KeyButton}" ToolTip="{Binding KeyTip}" Tag="{Binding}" Click="OnToggleKeyframe"
                    Visibility="{Binding HasToggle, Converter={StaticResource Visible}}">
              <local:Icon Data="{StaticResource DiamondShape}" Filled="{Binding KeyHere}" Thickness="1.8" Width="11" Height="11" />
            </Button>
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Number>
      <local:InspectorTemplates.Row>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Parts}" Focusable="False" Margin="0,0,-6,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,6,0">
                    <TextBox Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" Padding="22,5,6,5" ToolTip="{Binding PartTip}"
                             PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" GotKeyboardFocus="OnFieldEntered" />
                    <TextBlock Text="{Binding Prefix}" Style="{StaticResource BoxPrefix}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Column="2" Style="{StaticResource KeyButton}" ToolTip="{Binding KeyTip}" Tag="{Binding}" Click="OnToggleKeyframe"
                    Visibility="{Binding HasToggle, Converter={StaticResource Visible}}">
              <local:Icon Data="{StaticResource DiamondShape}" Filled="{Binding KeyHere}" Thickness="1.8" Width="11" Height="11" />
            </Button>
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Row>
      <local:InspectorTemplates.Columns>
        <DataTemplate>
          <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" Margin="0,2,20,2">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" FontSize="11" Margin="0,0,0,4" />
                  <Grid>
                    <TextBox Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" Padding="8,5,18,5" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" />
                    <TextBlock Text="{Binding Unit}" Style="{StaticResource BoxUnit}" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </local:InspectorTemplates.Columns>
      <local:InspectorTemplates.Slider>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="68" />
              <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Amount, Mode=OneTime}" Tag="{Binding}" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                    ToolTip="{Binding Tip}" ValueChanged="OnSliderMoved" PreviewMouseLeftButtonDown="OnSliderPressed" PreviewMouseLeftButtonUp="OnSliderReleased" KeyUp="OnSliderKey" />
            <Grid Grid.Column="2" Margin="8,0,0,0">
              <TextBox Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" Padding="8,5,20,5" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" GotKeyboardFocus="OnFieldEntered" />
              <TextBlock Text="{Binding Unit}" Style="{StaticResource BoxUnit}" />
            </Grid>
            <Button Grid.Column="3" Style="{StaticResource KeyButton}" ToolTip="{Binding KeyTip}" Tag="{Binding}" Click="OnToggleKeyframe"
                    Visibility="{Binding HasToggle, Converter={StaticResource Visible}}">
              <local:Icon Data="{StaticResource DiamondShape}" Filled="{Binding KeyHere}" Thickness="1.8" Width="11" Height="11" />
            </Button>
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Slider>
      <local:InspectorTemplates.Chips>
        <DataTemplate>
          <ItemsControl ItemsSource="{Binding Attached}" Focusable="False" Margin="0,2,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button x:Name="Chip" Style="{StaticResource Chip}" Tag="{Binding}" ToolTip="{Binding Tip}" Click="OnChip">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Color, Converter={StaticResource Swatch}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Text}" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Selectable}" Value="True">
                    <Setter TargetName="Chip" Property="Cursor" Value="Hand" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </local:InspectorTemplates.Chips>
      <local:InspectorTemplates.Text>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" Padding="8,5" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" />
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Text>
      <local:InspectorTemplates.Color>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <Grid Grid.Column="1">
              <TextBox Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" Padding="8,5,30,5" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" />
              <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,7,0" BorderBrush="{StaticResource ScrollThumbHoverBrush}" BorderThickness="1"
                      Background="{Binding Value, Converter={StaticResource Swatch}}" HorizontalAlignment="Right" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Color>
      <local:InspectorTemplates.LongText>
        <DataTemplate>
          <StackPanel Margin="0,2,26,2">
            <TextBox Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto" ToolTip="{Binding Tip}" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" />
          </StackPanel>
        </DataTemplate>
      </local:InspectorTemplates.LongText>
      <local:InspectorTemplates.Toggle>
        <DataTemplate>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding IsOn, Mode=OneTime}" Tag="{Binding}" Click="OnFieldToggled" />
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Toggle>
      <local:InspectorTemplates.Choice>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Options}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding Name}" GroupName="{Binding Group}" IsChecked="{Binding Selected, Mode=OneTime}"
                               Tag="{Binding}" Click="OnFieldChosen" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Choice>
    </local:InspectorTemplates>

    <DataTemplate x:Key="ChoiceTemplate">
      <RadioButton x:Name="Choice" Style="{StaticResource SegmentButton}" Content="{Binding Label}" GroupName="{Binding Group}" IsChecked="{Binding Selected, Mode=OneTime}"
                   IsEnabled="{Binding Usable}" ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True" Tag="{Binding}" Click="OnPageChoice" />
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Usable}" Value="False">
          <Setter TargetName="Choice" Property="Opacity" Value="0.45" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The Activity view: a step under its day, after a note when the saves before it aren't kept:
         who made it, with a line down to the next, its title, who, when and the revision, Restore
         (or "Current" for the newest), and its edits. -->
    <DataTemplate x:Key="ActivityStepTemplate">
      <StackPanel>
        <TextBlock x:Name="DayText" Text="{Binding Day}" Style="{StaticResource PanelTitle}" Margin="0,0,0,12" />
        <TextBlock x:Name="GapText" Text="Saves in between aren't kept" Style="{StaticResource Secondary}" FontSize="12" FontStyle="Italic" Margin="42,0,0,14" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border x:Name="Avatar" Width="28" Height="28" CornerRadius="14" Background="{StaticResource ClaudeBrush}">
            <TextBlock x:Name="AvatarText" Text="{Binding Initial}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSoftTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Rectangle Grid.Row="1" Width="2" MinHeight="16" Fill="{StaticResource DividerBrush}" HorizontalAlignment="Center" />
          <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="14,2,0,20">
            <DockPanel>
              <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restore" Tag="{Binding}" Click="OnRestoreStep" Height="28" Padding="10,0" FontSize="12"
                      Background="Transparent" VerticalAlignment="Top" Margin="12,0,0,0"
                      ToolTip="Put the project back as it was after this step, as a new save; undo takes it back" />
              <TextBlock x:Name="CurrentText" DockPanel.Dock="Right" Text="Current" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Top"
                         Margin="12,5,0,0" Visibility="Collapsed" ToolTip="The project as it is now" />
              <WrapPanel VerticalAlignment="Center" Margin="0,3,0,0">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border x:Name="WhoTag" CornerRadius="9" Padding="7,1,7,2" Background="{StaticResource ClaudeBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock x:Name="WhoText" Text="{Binding Who}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftTextBrush}" />
                </Border>
                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
              </WrapPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Edits}" Focusable="False" Margin="0,8,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource IconTextBrush}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ByEditor}" Value="True">
          <Setter TargetName="Avatar" Property="Background" Value="{StaticResource YouBrush}" />
          <Setter TargetName="AvatarText" Property="Foreground" Value="{StaticResource YouTextBrush}" />
          <Setter TargetName="WhoTag" Property="Background" Value="{StaticResource YouBrush}" />
          <Setter TargetName="WhoText" Property="Foreground" Value="{StaticResource YouTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Day}" Value="{x:Null}">
          <Setter TargetName="DayText" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Gap}" Value="False">
          <Setter TargetName="GapText" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Restore}" Value="{x:Null}">
          <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Newest}" Value="True">
          <Setter TargetName="CurrentText" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A request to type in the Claude chat, on the Activity view's side card. -->
    <Style x:Key="AskExample" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- The Export view: a preset's card (its title, then the size and frame rate, or what it needs),
         a caption group to save as an .srt file, Claude's running export, and an exported file. -->
    <DataTemplate x:Key="PresetCardTemplate">
      <RadioButton Style="{StaticResource ChoiceCard}" GroupName="{Binding Group}" IsChecked="{Binding Selected, Mode=OneTime}" IsEnabled="{Binding Usable}"
                   ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True" Tag="{Binding}" Click="OnPageChoice" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        </StackPanel>
      </RadioButton>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Usable}" Value="False">
          <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource UnusableTextBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="SrtChoiceTemplate">
      <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneTime}" Tag="{Binding}" ToolTip="{Binding Tip}" Click="OnSrtChoice" Margin="16,0,0,0" />
    </DataTemplate>

    <DataTemplate x:Key="RunningExportCard">
      <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentSoftTextBrush}" Margin="8,0,0,0" />
            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ProgressBar Height="4" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,8" />
          <TextBlock Text="{Binding By}" Style="{StaticResource Secondary}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="QueueRowTemplate">
      <Border x:Name="Row" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,14">
        <DockPanel>
          <Button x:Name="RowAction" DockPanel.Dock="Right" Style="{StaticResource FieldButton}" Height="32" MinWidth="76" Padding="12,0" FontSize="12" Margin="14,0,0,0"
                  VerticalAlignment="Center" Content="{Binding Row.Action}" ToolTip="{Binding Row.ActionTip}" Tag="{Binding Row}" Click="OnQueueAction" />
          <StackPanel DockPanel.Dock="Right" Width="170" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock x:Name="RowStatus" Text="{Binding Row.Status}" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Row.Detail}" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" TextTrimming="None"
                       Margin="0,3,0,0" ToolTip="{Binding Row.Detail}" />
          </StackPanel>
          <Border DockPanel.Dock="Left" Width="72" Height="40" CornerRadius="6" Background="{StaticResource ControlBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
            <Border CornerRadius="6" Background="{Binding Row.Picture}" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Row.File}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border x:Name="WhoTag" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="{StaticResource YouBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="WhoText" Text="{Binding Row.Who}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource YouTextBrush}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Row.Line}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,5,0,0" />
            <ProgressBar x:Name="RowBar" Height="4" Maximum="100" MaxWidth="360" HorizontalAlignment="Stretch" Value="{Binding Row.Percent, Mode=OneWay}" Margin="0,7,0,0" Visibility="Collapsed" />
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Row.Claude}" Value="True">
          <Setter TargetName="WhoTag" Property="Background" Value="{StaticResource ClaudeBrush}" />
          <Setter TargetName="WhoText" Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Row.HasBar}" Value="True">
          <Setter TargetName="RowBar" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Row.Action}" Value="{x:Null}">
          <Setter TargetName="RowAction" Property="Visibility" Value="Hidden" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Row.Tone}" Value="Running">
          <Setter TargetName="Row" Property="Background" Value="#151A27" />
          <Setter TargetName="RowStatus" Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Row.Tone}" Value="Done">
          <Setter TargetName="RowStatus" Property="Foreground" Value="{StaticResource YouTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Row.Tone}" Value="Failed">
          <Setter TargetName="RowStatus" Property="Foreground" Value="#FFB4A8" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Row.Tone}" Value="Stopped">
          <Setter TargetName="RowStatus" Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="CacheLegendTemplate">
      <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
        <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Text}" Style="{StaticResource Secondary}" FontSize="12" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ExportFileCard">
      <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Style="{StaticResource SquareButton}" Click="OnPlayExportFile" Tag="{Binding Path}" ToolTip="Play it in the default video player" AutomationProperties.Name="Play">
              <local:Icon Data="{StaticResource PlayShape}" Filled="True" Width="12" Height="12" />
            </Button>
            <Button Style="{StaticResource SquareButton}" Margin="8,0,0,0" Click="OnShowExportFile" Tag="{Binding Path}" ToolTip="Show it in its folder" AutomationProperties.Name="Show in folder">
              <local:Icon Data="{StaticResource FolderShape}" Width="14" Height="14" />
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Home's projects: cards in as many columns as fit (the list's Tag is its HomeLayout), or rows. -->
    <ItemsPanelTemplate x:Key="ProjectCards">
      <UniformGrid Columns="{Binding Tag.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Top" />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="ProjectRows">
      <StackPanel />
    </ItemsPanelTemplate>

    <SolidColorBrush x:Key="PictureBrush" Color="#14161B" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#CC0A0C10" />

    <DataTemplate x:Key="ProjectCard">
      <Button x:Name="Card" Style="{StaticResource CardButton}" Click="OnOpenListed" Tag="{Binding Directory}" ToolTip="{Binding Directory}" Margin="0,0,20,24"
              AutomationProperties.Name="{Binding Name}">
        <StackPanel>
          <Border x:Name="Frame" Height="{Binding Tag.PictureHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CornerRadius="10"
                  Background="{StaticResource PictureBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
              <Border CornerRadius="9" Background="{Binding Picture}" />
              <Grid x:Name="EmptyBox" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="12*" />
                  <RowDefinition Height="76*" />
                  <RowDefinition Height="12*" />
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="1" Stretch="Uniform">
                  <Rectangle Width="{Binding EmptyWidth}" Height="{Binding EmptyHeight}" RadiusX="6" RadiusY="6" Stroke="#4A5060" StrokeThickness="1.5" StrokeDashArray="3 2" />
                </Viewbox>
                <TextBlock Grid.Row="1" Text="Empty" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,8,0">
                <Border x:Name="ClaudeBadge" Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,6,6">
                  <TextBlock Text="{Binding ClaudeEdited}" Foreground="{StaticResource OnAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="LanguagesBadge" Background="{StaticResource BadgeBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,6,6">
                  <TextBlock Text="{Binding Languages}" FontSize="11" />
                </Border>
              </WrapPanel>
              <Border x:Name="LengthBadge" Background="{StaticResource BadgeBrush}" CornerRadius="5" Padding="6,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Length}" FontFamily="Consolas" FontSize="11" />
              </Border>
            </Grid>
          </Border>
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Empty}" Value="True">
          <Setter TargetName="EmptyBox" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ClaudeEdited}" Value="{x:Null}">
          <Setter TargetName="ClaudeBadge" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Languages}" Value="{x:Null}">
          <Setter TargetName="LanguagesBadge" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Length}" Value="{x:Null}">
          <Setter TargetName="LengthBadge" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
          <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Card}" Value="True">
          <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ProjectRow">
      <Button Style="{StaticResource ListButton}" Click="OnOpenListed" Tag="{Binding Directory}" ToolTip="{Binding Directory}" Margin="0,0,20,2"
              AutomationProperties.Name="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="96" Height="54" CornerRadius="6" Background="{StaticResource PictureBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
              <Border CornerRadius="5" Background="{Binding Picture}" />
              <TextBlock x:Name="EmptyText" Text="Empty" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="ClaudeBadge" Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
              <TextBlock Text="{Binding ClaudeEdited}" Foreground="{StaticResource OnAccentBrush}" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="LanguagesText" Text="{Binding Languages}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Length}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding ClaudeEdited}" Value="{x:Null}">
          <Setter TargetName="ClaudeBadge" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Empty}" Value="True">
          <Setter TargetName="EmptyText" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="StartCard" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SwatchChoice" TargetType="RadioButton">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DialogCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource DialogBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Margin" Value="40" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.6" Color="Black" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DialogLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource IconTextBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#22252D">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,2,2" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#3A3F4B">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="0,0,1,1" />
                <RectangleGeometry Rect="1,1,1,1" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <DataTemplate x:Key="KeyCapTemplate">
      <Border MinWidth="22" Height="24" Padding="7,0" Margin="4,0,0,0" CornerRadius="6" Background="{StaticResource ChosenBrush}" BorderBrush="{StaticResource PanelBrush}" BorderThickness="0,0,0,2">
        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ShortcutGroupTemplate">
      <StackPanel Width="300" Margin="0,0,32,14">
        <TextBlock Text="{Binding Name}" Style="{StaticResource PanelTitle}" FontSize="11" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource MenuBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                <DockPanel>
                  <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Keys}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="Or" Text="/" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0,2,0" VerticalAlignment="Center" />
                          <ItemsControl ItemsSource="{Binding Caps}" ItemTemplate="{StaticResource KeyCapTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                          </ItemsControl>
                        </StackPanel>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding First}" Value="True">
                            <Setter TargetName="Or" Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Action}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CanvasChoiceTemplate">
      <RadioButton Style="{StaticResource ChoiceCard}" IsChecked="{Binding Selected, Mode=OneTime}" Tag="{Binding}" Click="OnNewCanvas" Margin="0,0,8,8"
                   AutomationProperties.Name="{Binding Name}">
        <StackPanel Orientation="Horizontal" Margin="-2">
          <Grid Width="30" Height="30" Margin="0,0,10,0">
            <Border x:Name="Shape" Width="{Binding ShapeWidth}" Height="{Binding ShapeHeight}" BorderBrush="{StaticResource SecondaryTextBrush}" BorderThickness="2" CornerRadius="3" />
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Size}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </RadioButton>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="MissingFileTemplate">
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,12">
        <StackPanel>
          <Border BorderBrush="{StaticResource MenuBrush}" BorderThickness="0,0,0,1" Padding="16,14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding UsedBy}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
              <Rectangle Width="64" Height="36" RadiusX="6" RadiusY="6" Fill="#2A1A1A" Stroke="#6A3030" StrokeDashArray="3 2" Margin="0,0,12,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding WasAt}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
          <StackPanel Margin="16,14">
            <TextBlock x:Name="Status" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Style="{StaticResource ChoiceCard}" IsChecked="{Binding Chosen, Mode=OneWay}" Tag="{Binding}" Click="OnRelinkCandidate" Margin="0,0,0,8"
                               AutomationProperties.Name="{Binding Path}">
                    <DockPanel Margin="-2">
                      <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource YouBrush}" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Reason}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource YouTextBrush}" />
                      </Border>
                      <Border Width="64" Height="36" CornerRadius="6" Background="{StaticResource InputBrush}" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   ToolTip="{Binding Path}" />
                      </StackPanel>
                    </DockPanel>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,2,0,0">
              <Button Content="Search another folder…" Padding="12,6" Margin="0,0,8,0" Tag="{Binding}" Click="OnRelinkFolder" ToolTip="Look in a folder you pick, and the folders in it, for every file that's missing" />
              <Button Content="Choose file…" Padding="12,6" Margin="0,0,8,0" Tag="{Binding}" Click="OnRelinkFile" ToolTip="Pick the file yourself" />
              <Button Content="Leave it missing" Padding="12,6" Tag="{Binding}" Click="OnRelinkKeep" ToolTip="Don't relink this file now" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Found}" Value="True">
          <Setter TargetName="Status" Property="Foreground" Value="{StaticResource YouTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Failed}" Value="True">
          <Setter TargetName="Status" Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="WelcomeStepTemplate">
      <Button Style="{StaticResource CardButton}" Tag="{Binding}" Click="OnWelcomeStep" Margin="0,0,0,6" AutomationProperties.Name="{Binding Title}">
        <Border x:Name="Card" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
          <DockPanel>
            <Border x:Name="Dot" Width="30" Height="30" CornerRadius="15" Background="{StaticResource ChosenBrush}" Margin="0,0,14,0">
              <TextBlock x:Name="Mark" Text="{Binding Mark}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource IconTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Done}" Value="True">
          <Setter TargetName="Dot" Property="Background" Value="{StaticResource YouBrush}" />
          <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource YouTextBrush}" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Current}" Value="True" />
            <Condition Binding="{Binding Done}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding Current}" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{StaticResource ChosenCardBrush}" />
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Card" Property="BorderThickness" Value="2" />
          <Setter TargetName="Card" Property="Padding" Value="13" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="CaptionCell" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <EventSetter Event="PreviewKeyDown" Handler="OnCaptionKey" />
      <EventSetter Event="LostKeyboardFocus" Handler="OnCaptionLeft" />
      <EventSetter Event="GotKeyboardFocus" Handler="OnCaptionEntered" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{StaticResource InputBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CaptionTimeBox" TargetType="TextBox" BasedOn="{StaticResource CaptionCell}">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource IconTextBrush}" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="AcceptsReturn" Value="False" />
    </Style>

    <Style x:Key="CaptionChip" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Height="30" Padding="11,0" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LookChoice" TargetType="RadioButton">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="CaptionChipTemplate">
      <Border Background="Transparent" Margin="6,0,0,6" ToolTip="{Binding Tip}">
        <Button x:Name="Chip" Style="{StaticResource CaptionChip}" Tag="{Binding}" Click="OnCaptionSource" IsHitTestVisible="{Binding Pickable}" Focusable="{Binding Pickable}"
                AutomationProperties.Name="{Binding Chip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Name" Text="{Binding Chip}" FontSize="12" FontWeight="Medium" />
            <TextBlock x:Name="Count" Text="{Binding Count}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource WarningBrush}" Margin="6,0,0,0" />
          </StackPanel>
        </Button>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Full}" Value="True">
          <Setter TargetName="Count" Property="Foreground" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Source}" Value="True">
          <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoftBrush}" />
          <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
          <Setter TargetName="Name" Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
          <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="CaptionRowTemplate">
      <Border x:Name="Row" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
          <TextBlock x:Name="Number" Text="{Binding Number}" Foreground="{StaticResource SecondaryTextBrush}" Margin="14,14,0,0" />
          <StackPanel Grid.Column="1" Margin="6,8">
            <TextBox x:Name="StartBox" Style="{StaticResource CaptionTimeBox}" Text="{Binding StartText, Mode=OneWay}" Tag="{Binding}" AutomationProperties.Name="Start"
                     ToolTip="When it starts, in every language: 00:03.40, or seconds" />
            <TextBox x:Name="EndBox" Style="{StaticResource CaptionTimeBox}" Text="{Binding EndText, Mode=OneWay}" Tag="{Binding}" AutomationProperties.Name="End"
                     ToolTip="When it ends, in every language" />
          </StackPanel>
          <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}" Focusable="False" Margin="0,6,6,6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource CaptionCell}" Text="{Binding Text, Mode=OneWay}" Tag="{Binding}" FontFamily="{Binding Font}" ToolTip="{Binding Hint}" Margin="2"
                         AutomationProperties.Name="{Binding Column.Heading}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Current}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource ChosenCardBrush}" />
          <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
          <Setter TargetName="StartBox" Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
          <Setter TargetName="EndBox" Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Draft}" Value="True">
          <Setter TargetName="Number" Property="Text" Value="New" />
          <Setter TargetName="Number" Property="Foreground" Value="{StaticResource AccentSoftTextBrush}" />
          <Setter TargetName="Number" Property="FontSize" Value="11" />
          <Setter TargetName="Number" Property="Margin" Value="8,15,0,0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="CaptionHeadingTemplate">
      <TextBlock Text="{Binding HeadingCaps}" Margin="10,10,4,10" TextTrimming="CharacterEllipsis" ToolTip="{Binding GroupId}" />
    </DataTemplate>

    <DataTemplate x:Key="CaptionFontTemplate">
      <DockPanel Margin="0,0,0,6">
        <TextBlock DockPanel.Dock="Left" Width="30" Text="{Binding Code}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
        <TextBox Text="{Binding Font, Mode=OneWay}" Tag="{Binding}" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" AutomationProperties.Name="{Binding Code}"
                 PreviewKeyDown="OnCaptionFontKey" LostKeyboardFocus="OnCaptionFontLeft" ToolTip="An installed font's family name for this track's captions, such as Yu Gothic" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="TrackCardTemplate">
      <Button Tag="{Binding Id}" Click="OnTrackCard" Margin="0,0,0,8" Cursor="Hand" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Title}"
              ToolTip="Choose this object: its box is shown on the frame, and its settings on the right">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource HeaderBrush}" Padding="12">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                <Setter TargetName="Bd" Property="Padding" Value="11" />
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChosenCardBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderBrush" Value="#3A3F4B" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Hide}" Value="Blur">
                      <Setter Property="Background" Value="#1F3A2C" />
                      <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Hide}" Value="Pixelate">
                      <Setter Property="Background" Value="#2D2547" />
                      <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Hide}" Value="Solid">
                      <Setter Property="Background" Value="#2A2E37" />
                      <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding Hide}" FontSize="11" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Hide}" Value="Blur">
                        <Setter Property="Foreground" Value="#8EE0B0" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Hide}" Value="Pixelate">
                        <Setter Property="Foreground" Value="#CDBBFF" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Hide}" Value="Solid">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Span}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0" />
          <local:TrackBar Parts="{Binding Parts}" Margin="0,8,0,0" />
          <DockPanel Margin="0,8,0,0">
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Tag="{Binding Id}" Click="OnTrackFix" Foreground="#FFE2A8" FontWeight="SemiBold" FontSize="12"
                    AutomationProperties.Name="Fix" ToolTip="Go to the first frame where the tracker lost it or wasn't sure, to drag its box where it is">
              <TextBlock Text="Fix" TextDecorations="Underline" />
            </Button>
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="12" Foreground="#F5D394" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Problem}" Foreground="#F5D394" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="EasingTileTemplate">
      <Button Tag="{Binding Easing}" Margin="0,0,8,8" IsEnabled="{Binding Enabled}" Click="OnEasingTile" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Name}" FocusVisualStyle="{x:Null}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,8,4,6">
              <StackPanel>
                <Grid Width="44" Height="32" HorizontalAlignment="Center">
                  <Path Data="M4,28 L40,28" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                  <Path x:Name="Curve" Data="{Binding Curve}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding Chosen}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChosenCardBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                <Setter TargetName="Bd" Property="Padding" Value="3,7,3,5" />
                <Setter TargetName="Curve" Property="Stroke" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="MixerSlotTemplate">
      <Border Height="24" CornerRadius="5" Background="{StaticResource InputBrush}" Padding="8,0" Margin="0,0,0,4" ToolTip="{Binding Tip}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="6" Height="6" Fill="{Binding Dot}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="MixerStripTemplate">
      <Border Width="132" CornerRadius="12" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,10,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource MixerSlotTemplate}" Focusable="False" Height="52" Margin="0,0,0,6" />
          <DockPanel Margin="0,0,0,10" TextElement.FontSize="11">
            <TextBlock Text="Pan" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding PanText, Mode=OneTime}" FontFamily="Consolas" Foreground="{StaticResource IconTextBrush}" Width="32" TextAlignment="Right" VerticalAlignment="Center" />
            <local:MixerPan Height="16" Value="{Binding Pan, Mode=OneTime}" Tag="{Binding}" Moved="OnPanMoved" Committed="OnPanCommitted" AutomationProperties.Name="Pan"
                            ToolTip="Drag to place the role left or right (Left and Right step 5%; double-click or Home centers it)" />
          </DockPanel>
          <local:MixerFader Height="220" Value="{Binding Gain, Mode=OneTime}" Tag="{Binding}" Moved="OnFaderMoved" Committed="OnFaderCommitted" AutomationProperties.Name="Level"
                            ToolTip="The role's level in dB, on top of each clip's volume (Up and Down step half a dB; double-click or Home for 0 dB)" />
          <TextBlock Text="{Binding GainText, Mode=OneTime}" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,10" />
          <UniformGrid Columns="2">
            <ToggleButton Style="{StaticResource MuteToggle}" Content="M" Margin="0,0,2,0" IsChecked="{Binding Muted, Mode=OneTime}" Tag="{Binding}" Click="OnStripMute"
                          ToolTip="{Binding MuteTip}" AutomationProperties.Name="Mute" />
            <ToggleButton Style="{StaticResource SoloToggle}" Content="S" Margin="2,0,0,0" IsChecked="{Binding Soloed, Mode=OneTime}" Tag="{Binding}" Click="OnStripSolo"
                          ToolTip="{Binding SoloTip}" AutomationProperties.Name="Solo" />
          </UniformGrid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="PreviewLanguageTemplate">
      <RadioButton Style="{StaticResource SegmentButton}" GroupName="CaptionPreviewLanguage" Content="{Binding Code}" IsChecked="{Binding Chosen, Mode=OneTime}" Tag="{Binding Language}"
                   FontSize="11" FontWeight="Medium" Checked="OnPreviewLanguage" ToolTip="{Binding Tip}" />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" MinHeight="48" Padding="12,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LogoButton" Style="{StaticResource LogoButton}" IsEnabled="False" Click="OnCloseProject" ToolTip="Close the project and go back to the projects"
                  AutomationProperties.Name="Back to the projects" />
          <TextBlock x:Name="AppName" Text="ZeyoCut" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
          <StackPanel x:Name="Crumbs" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
            <Button x:Name="ProjectsLink" Style="{StaticResource LinkButton}" Content="Projects" FontSize="13" Click="OnCloseProject" ToolTip="Close the project and go back to the projects" />
            <TextBlock Text="/" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="7,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ProjectName" FontSize="13" FontWeight="SemiBold" MaxWidth="280" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="ExportCrumb" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed">
              <Run Text=" / " Foreground="{StaticResource SecondaryTextBrush}" FontWeight="Normal" /><Run x:Name="CrumbName" Text="Export" />
            </TextBlock>
            <Border x:Name="SaveBadge" Style="{StaticResource Pill}" Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SaveIcon" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="SaveBadgeText" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <Border x:Name="ModeBar" Grid.Column="1" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="9" Padding="3"
                Margin="16,0" VerticalAlignment="Center" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="EditMode" GroupName="Mode" Style="{StaticResource TabSegment}" Content="Edit" IsChecked="True" Checked="OnMode" ToolTip="The timeline, preview and inspector (Ctrl+1)" />
            <RadioButton x:Name="AudioMode" GroupName="Mode" Style="{StaticResource TabSegment}" Content="Audio" Checked="OnMode"
                         ToolTip="Each sound role's level, pan and mute, the loudness, the ducking and volume keyframes (Ctrl+2)" />
            <RadioButton x:Name="AnimateMode" GroupName="Mode" Style="{StaticResource TabSegment}" Content="Animate" Checked="OnMode"
                         ToolTip="Keyframes as a dope sheet or as curves, their easing, and the onion skin (Ctrl+3)" />
            <RadioButton x:Name="TrackMode" GroupName="Mode" Style="{StaticResource TabSegment}" Content="Track &amp; blur" Checked="OnMode"
                         ToolTip="Track objects in a clip, correct their boxes, and hide them with a blur, pixels or a solid box (Ctrl+4)" />
            <RadioButton x:Name="CaptionsMode" GroupName="Mode" Style="{StaticResource TabSegment}" Content="Captions" Checked="OnMode"
                         ToolTip="Every language's captions side by side, and their style (Ctrl+5)" />
            <RadioButton x:Name="ActivityMode" GroupName="Mode" Style="{StaticResource TabSegment}" Content="Activity" Checked="OnMode"
                         ToolTip="What Claude and you saved last, and how to work with Claude (Ctrl+6)" />
            <RadioButton x:Name="ExportMode" GroupName="Mode" Visibility="Collapsed" Checked="OnMode" />
            <RadioButton x:Name="MediaMode" GroupName="Mode" Visibility="Collapsed" Checked="OnMode" />
            <RadioButton x:Name="SourceMode" GroupName="Mode" Visibility="Collapsed" Checked="OnMode" />
            <RadioButton x:Name="TitlesMode" GroupName="Mode" Visibility="Collapsed" Checked="OnMode" />
            <RadioButton x:Name="EffectsMode" GroupName="Mode" Visibility="Collapsed" Checked="OnMode" />
            <RadioButton x:Name="ColorMode" GroupName="Mode" Visibility="Collapsed" Checked="OnMode" />
          </StackPanel>
        </Border>

        <StackPanel x:Name="ProjectCommands" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
          <Button x:Name="UndoButton" Style="{StaticResource HeaderIcon}" Content="&#xE7A7;" ToolTip="Undo your last change (Ctrl+Z)" AutomationProperties.Name="Undo" Click="OnUndo" />
          <Button x:Name="RedoButton" Style="{StaticResource HeaderIcon}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Shift+Z)" AutomationProperties.Name="Redo" Click="OnRedo" />
          <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="8,0" />
          <Border x:Name="ClaudeBadge" Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock x:Name="ClaudeText" FontSize="11" Foreground="{StaticResource AccentSoftTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button x:Name="ExportViewButton" Style="{StaticResource AccentButton}" Click="OnExportView" ToolTip="Render the project to an MP4 (Ctrl+E)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE898;" FontSize="13" FontWeight="Normal" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Export" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="BackToEdit" Padding="12,6" Click="OnBackToEdit" ToolTip="Back to the timeline (Ctrl+1)" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76B;" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="Back to edit" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer x:Name="StartPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel x:Name="HomeContent" MaxWidth="1200" Margin="48,40,48,32" SizeChanged="OnHomeSized">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="Projects" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="14" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" LineHeight="21"
                       Text="Claude builds the first cut over MCP. Open a project to fine-tune it: every change is saved as you make it, and Claude sees it on its next step." />
          </StackPanel>
          <Button x:Name="PrefsButton" Grid.Column="1" Style="{StaticResource FieldButton}" Width="40" Height="40" Padding="0" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                  Click="OnPreferences" ToolTip="Preferences: snapping, Claude's highlight, still length, preview quality, export defaults" AutomationProperties.Name="Preferences">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Grid Grid.Column="1" Width="280" Height="40" Margin="50,0,0,0" VerticalAlignment="Bottom">
            <TextBox x:Name="HomeSearch" Background="{StaticResource HeaderBrush}" Padding="34,10,10,0" FontSize="14" TextChanged="OnHomeSearch"
                     AutomationProperties.Name="Search projects" ToolTip="Show the projects whose names have this in them" />
            <local:Icon Data="{StaticResource SearchShape}" Width="15" Height="15" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                        Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock x:Name="HomeSearchHint" Text="Search projects" FontSize="14" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{StaticResource SecondaryTextBrush}" />
          </Grid>
        </Grid>
        <TextBlock x:Name="StartError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
        <TextBlock Text="START SOMETHING NEW" Style="{StaticResource PanelTitle}" FontSize="12" Margin="0,32,0,14" />
        <WrapPanel x:Name="StartCards" Margin="0,0,-12,0">
          <Button Style="{StaticResource StartCard}" Width="210" Margin="0,0,12,12" Click="OnNewProjectCard" ToolTip="A new project: its name, canvas, frame rate and background (Ctrl+N)">
            <StackPanel Orientation="Horizontal">
              <Grid Width="44" Height="32" Margin="0,0,14,0">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="New project…" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="Ctrl + N" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource StartCard}" Width="210" Margin="0,0,12,12" Tag="YouTube" Click="OnNewProjectCard" ToolTip="A new landscape project, 1920×1080">
            <StackPanel Orientation="Horizontal">
              <Grid Width="44" Height="32" Margin="0,0,14,0">
                <Border Width="44" Height="26" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="4" />
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Landscape" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="16:9 · 1920×1080" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource StartCard}" Width="210" Margin="0,0,12,12" Tag="Shorts" Click="OnNewProjectCard" ToolTip="A new vertical project for Shorts, Reels and TikTok, 1080×1920">
            <StackPanel Orientation="Horizontal">
              <Grid Width="44" Height="32" Margin="0,0,14,0">
                <Border Width="18" Height="32" BorderBrush="{StaticResource WarningBrush}" BorderThickness="2" CornerRadius="4" />
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Shorts / Reels" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="9:16 · 1080×1920" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource StartCard}" Width="210" Margin="0,0,12,12" Tag="Square" Click="OnNewProjectCard" ToolTip="A new square project, 1080×1080">
            <StackPanel Orientation="Horizontal">
              <Grid Width="44" Height="32" Margin="0,0,14,0">
                <Border Width="28" Height="28" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="2" CornerRadius="4" />
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Square" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="1:1 · 1080×1080" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource OpenCard}" Click="OnOpen" Width="210" Margin="0,0,12,12" ToolTip="Open a ZeyoCut project folder from anywhere (Ctrl+O)">
            <StackPanel Orientation="Horizontal">
              <Grid Width="44" Height="32" Margin="0,0,14,0">
                <local:Icon Data="{StaticResource FolderShape}" Width="22" Height="22" Foreground="{StaticResource IconTextBrush}" />
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Open folder…" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="Ctrl + O" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </Button>
        </WrapPanel>
        <Grid x:Name="HomeListHeader" Margin="0,28,0,14">
          <TextBlock x:Name="RecentTitle" Text="RECENT" Style="{StaticResource PanelTitle}" FontSize="12" />
          <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="HomeCards" GroupName="HomeView" Style="{StaticResource SegmentButton}" Width="32" Height="28" IsChecked="True" Checked="OnHomeView"
                           ToolTip="Show the projects as cards" AutomationProperties.Name="Cards">
                <local:Icon Data="{StaticResource CardsShape}" Width="14" Height="14" />
              </RadioButton>
              <RadioButton x:Name="HomeRows" GroupName="HomeView" Style="{StaticResource SegmentButton}" Width="32" Height="28" Checked="OnHomeView"
                           ToolTip="Show the projects as a list" AutomationProperties.Name="List">
                <local:Icon Data="{StaticResource RowsShape}" Width="14" Height="14" />
              </RadioButton>
            </StackPanel>
          </Border>
        </Grid>
        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource ProjectCard}" ItemsPanel="{StaticResource ProjectCards}" Margin="0,0,-20,0" Focusable="False" />
        <TextBlock x:Name="ProjectsTitle" Text="OTHER PROJECTS" Style="{StaticResource PanelTitle}" FontSize="12" Margin="0,16,0,14" />
        <ItemsControl x:Name="ProjectsList" ItemTemplate="{StaticResource ProjectCard}" ItemsPanel="{StaticResource ProjectCards}" Margin="0,0,-20,0" Focusable="False" />
        <TextBlock x:Name="ProjectsEmpty" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,40,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="HomeNoMatch" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,40,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Projects folder: " Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock x:Name="HomeFolder" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
          <TextBlock Text=" · " Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" />
          <Button Style="{StaticResource LinkButton}" Click="OnShowProjectsFolder" Foreground="{StaticResource AccentSoftTextBrush}" ToolTip="Open the projects folder in File Explorer">
            <TextBlock Text="Show folder" FontSize="12" />
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="AnimatePage" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="5*" MinHeight="220" />
        <RowDefinition Height="4*" MinHeight="240" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <DockPanel Background="{StaticResource PreviewBrush}">
          <Border DockPanel.Dock="Top" Height="40" BorderBrush="{StaticResource MenuBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel TextElement.FontSize="12">
              <ToggleButton x:Name="MotionPathToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSegment}" Height="28" FontWeight="Medium" Margin="6,0,0,0"
                            Click="OnMotionPathToggle" ToolTip="The selected layer's path: where its anchor goes, with a dot at each keyframe">
                <TextBlock Text="Motion path" Margin="2,0" />
              </ToggleButton>
              <Button x:Name="OnionCounts" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="28" Padding="0" Margin="2,0,0,0" Click="OnOnionCounts"
                      ToolTip="How many frames the onion skin draws before and after the playhead" AutomationProperties.Name="Onion skin frames">
                <local:Icon Data="{StaticResource ChevronDownShape}" Width="12" Height="12" Foreground="{StaticResource SecondaryTextBrush}" />
              </Button>
              <ToggleButton x:Name="OnionToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSegment}" Height="28" FontWeight="Medium" Click="OnOnionToggle"
                            ToolTip="The selected layer at the frames around the playhead, fainter the further they are, the ones after in green (Alt+O)">
                <StackPanel Orientation="Horizontal">
                  <local:Icon Data="{StaticResource OnionShape}" Width="14" Height="14" Margin="0,0,6,0" />
                  <TextBlock x:Name="OnionText" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <TextBlock Text="Program" Foreground="{StaticResource TextBrush}" FontWeight="Medium" VerticalAlignment="Center" />
              <TextBlock x:Name="AnimateFrameText" Foreground="{StaticResource SecondaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
          <Grid>
            <local:AnimatePreview x:Name="AnimateFrame" Frame="{Binding Source, ElementName=PreviewImage}" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Text, ElementName=PreviewMessage}" Visibility="{Binding Visibility, ElementName=PreviewMessage}"
                       TextWrapping="Wrap" TextTrimming="None" Margin="24" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </DockPanel>

        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
          <DockPanel Margin="16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
              <TextBlock x:Name="EasingSelectionText" DockPanel.Dock="Right" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="Easing" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Button x:Name="BezierApply" DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Content="Apply to selection" Height="34" Padding="12,0" Click="OnBezierApply"
                    ToolTip="The custom curve above for the selected keyframes' segments, as set_keyframes takes it (easing cubicBezier)" />
            <StackPanel DockPanel.Dock="Top">
              <ItemsControl x:Name="EasingTiles" Focusable="False" ItemTemplate="{StaticResource EasingTileTemplate}" Margin="0,0,-8,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="CUSTOM BEZIER" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,8" />
              <UniformGrid x:Name="BezierBoxes" Columns="4" Margin="0,0,-6,14">
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="x1" Style="{StaticResource Secondary}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox x:Name="BezierX1" Height="30" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Bezier x1"
                           ToolTip="The first handle's time, from 0 to 1" PreviewKeyDown="OnBezierKey" />
                </StackPanel>
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="y1" Style="{StaticResource Secondary}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox x:Name="BezierY1" Height="30" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Bezier y1"
                           ToolTip="The first handle's value: below 0 or above 1 overshoots" PreviewKeyDown="OnBezierKey" />
                </StackPanel>
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="x2" Style="{StaticResource Secondary}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox x:Name="BezierX2" Height="30" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Bezier x2"
                           ToolTip="The second handle's time, from 0 to 1" PreviewKeyDown="OnBezierKey" />
                </StackPanel>
                <StackPanel Margin="0,0,6,0">
                  <TextBlock Text="y2" Style="{StaticResource Secondary}" FontSize="11" Margin="0,0,0,4" />
                  <TextBox x:Name="BezierY2" Height="30" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Bezier y2"
                           ToolTip="The second handle's value: below 0 or above 1 overshoots" PreviewKeyDown="OnBezierKey" />
                </StackPanel>
              </UniformGrid>
            </StackPanel>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" VerticalAlignment="Top"
                       Text="An easing shapes the segment from a keyframe to the next one. Select keyframes below, then pick a curve." />
          </DockPanel>
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" MinHeight="40" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel TextElement.FontSize="12">
              <ToggleButton x:Name="FitCurvesToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSegment}" Height="28" FontWeight="Medium" Margin="10,0,0,0"
                            Click="OnFitCurves" ToolTip="The graph's time ruler fitted to the shown curves' keyframes, rather than the whole project">
                <TextBlock Text="Fit curves" Margin="2,0" />
              </ToggleButton>
              <TextBlock x:Name="KeyStatus" DockPanel.Dock="Right" FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource InputBrush}" CornerRadius="7" Padding="2">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DopeSheetMode" GroupName="KeyframeMode" Style="{StaticResource SegmentButton}" Content="Dope sheet" IsChecked="True" Checked="OnKeyframeMode"
                                 ToolTip="Each value's keyframes on its own row; drag them to retime" />
                    <RadioButton x:Name="GraphMode" GroupName="KeyframeMode" Style="{StaticResource SegmentButton}" Content="Graph" Checked="OnKeyframeMode"
                                 ToolTip="The values' curves; drag a keyframe to change its time and value" />
                  </StackPanel>
                </Border>
                <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="8,0" />
                <ToggleButton x:Name="LinearButton" Style="{StaticResource ToggleSegment}" Height="28" Tag="Linear" Click="OnEasingButton" FontWeight="Medium"
                              ToolTip="The selected keyframes' segments at an even speed">
                  <TextBlock Text="Linear" Margin="2,0" />
                </ToggleButton>
                <ToggleButton x:Name="SmoothButton" Style="{StaticResource ToggleSegment}" Height="28" Tag="EaseInOut" Click="OnEasingButton" FontWeight="Medium" Margin="2,0,0,0"
                              ToolTip="The selected keyframes' segments easing in and out (F9)">
                  <TextBlock Text="Smooth" Margin="2,0" />
                </ToggleButton>
                <ToggleButton x:Name="HoldButton" Style="{StaticResource ToggleSegment}" Height="28" Tag="Hold" Click="OnEasingButton" FontWeight="Medium" Margin="2,0,0,0"
                              ToolTip="The selected keyframes' values held until the next keyframe">
                  <TextBlock Text="Hold" Margin="2,0" />
                </ToggleButton>
              </StackPanel>
            </DockPanel>
          </Border>
          <local:KeyframeView x:Name="Keyframes" Seek="OnSeek" Edit="OnTimelineEdit" SelectionChanged="OnKeySelection" LayerChosen="OnKeyLayer" />
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="TrackPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.Resources>
        <Style x:Key="HideTile" TargetType="RadioButton">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Height" Value="56" />
          <Setter Property="Margin" Value="0,0,6,0" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Bd" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
                  </Trigger>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChosenCardBrush}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource UnusableTextBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Grid.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="260" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="14">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TrackClipText" DockPanel.Dock="Right" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Text="Tracked objects" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ToggleButton x:Name="TrackDraw" DockPanel.Dock="Top" Height="36" Margin="0,0,0,12" Click="OnTrackDraw" Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{StaticResource TextBrush}"
                        AutomationProperties.Name="Draw a box to track"
                        ToolTip="Then drag over the object in the viewer, on the frame where it's clearest, and track it backward or forward">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Grid Background="Transparent">
                  <Rectangle x:Name="Edge" RadiusX="8" RadiusY="8" Stroke="#3A3F4B" StrokeThickness="1" StrokeDashArray="4 3" />
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource ScrollThumbHoverBrush}" />
                  </Trigger>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Edge" Property="Fill" Value="{StaticResource AccentSoftBrush}" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource UnusableTextBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock x:Name="TrackDrawText" Text="Draw a box to track" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border x:Name="TrackProgressPanel" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8"
                    Margin="0,0,0,12" Visibility="Collapsed">
              <DockPanel>
                <Button x:Name="TrackStop" DockPanel.Dock="Right" Content="Stop" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center" Click="OnTrackStop"
                        ToolTip="Stop tracking; nothing is saved" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="TrackProgressText" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <ProgressBar x:Name="TrackProgress" Height="4" Maximum="100" Margin="0,6,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
            <TextBlock Text="TRACK THE BOX YOU DREW" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
            <UniformGrid Columns="2">
              <Button x:Name="TrackBackward" Height="34" Margin="0,0,3,0" Click="OnTrackBackward" ToolTip="Track the box from its frame back to the start of the clip">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76B;" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="Backward" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="TrackForward" Height="34" Margin="3,0,0,0" Click="OnTrackForward" ToolTip="Track the box from its frame on to the end of the clip">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Forward" FontWeight="Medium" VerticalAlignment="Center" />
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl x:Name="TrackCards" Focusable="False" ItemTemplate="{StaticResource TrackCardTemplate}" />
            </ScrollViewer>
            <TextBlock x:Name="TrackEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" VerticalAlignment="Top" />
          </Grid>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1" Background="{StaticResource PreviewBrush}">
        <Border DockPanel.Dock="Top" Height="40" BorderBrush="{StaticResource MenuBrush}" BorderThickness="0,0,0,1" Padding="12,0">
          <DockPanel TextElement.FontSize="12">
            <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TrackBoxes" GroupName="TrackViewMode" Style="{StaticResource SegmentButton}" Content="Boxes" Tag="Boxes" IsChecked="True" Checked="OnTrackViewMode"
                             ToolTip="The frame without its redactions, each track's box on it with how sure the tracker is" />
                <RadioButton x:Name="TrackResult" GroupName="TrackViewMode" Style="{StaticResource SegmentButton}" Content="Result" Tag="Result" Checked="OnTrackViewMode"
                             ToolTip="The frame as it's exported, the boxes hidden" />
                <RadioButton x:Name="TrackSplit" GroupName="TrackViewMode" Style="{StaticResource SegmentButton}" Content="Split" Tag="Split" Checked="OnTrackViewMode"
                             ToolTip="The frame without its redactions on the left, as it's exported on the right" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="TrackViewClip" Foreground="{StaticResource TextBrush}" FontWeight="Medium" VerticalAlignment="Center" />
            <TextBlock x:Name="TrackFrameText" Foreground="{StaticResource SecondaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <Grid>
          <local:TrackView x:Name="TrackViewer" Frame="{Binding Source, ElementName=PreviewImage}" RenderOptions.BitmapScalingMode="HighQuality"
                           BoxDrawn="OnTrackBoxDrawn" BoxMoved="OnTrackBoxMoved" TrackChosen="OnTrackChosen" />
          <TextBlock x:Name="TrackViewMessage" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="24" MaxWidth="520"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
        </Grid>
      </DockPanel>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <DockPanel Margin="14">
          <Border DockPanel.Dock="Bottom" Background="{StaticResource NoteBrush}" BorderBrush="{StaticResource NoteBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
            <TextBlock x:Name="TrackNote" Foreground="{StaticResource AccentSoftTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <DockPanel>
                <Border x:Name="TrackSettingsColor" Width="10" Height="10" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TrackSettingsTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="TrackSettingsHint" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" Margin="0,6,0,0" />
              <StackPanel x:Name="TrackSettings" Margin="0,16,0,0">
                <TextBlock Text="HIDE WITH" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" />
                <UniformGrid Columns="3" Margin="0,0,-6,16">
                  <RadioButton x:Name="TrackBlur" GroupName="TrackStyle" Style="{StaticResource HideTile}" Tag="Blur" Click="OnTrackStyle" AutomationProperties.Name="Blur"
                               ToolTip="A blur over the box, its radius scaled to the box's size">
                    <StackPanel>
                      <Border Width="22" Height="14" CornerRadius="3" Background="#8C96AA" HorizontalAlignment="Center">
                        <Border.Effect>
                          <BlurEffect Radius="3" />
                        </Border.Effect>
                      </Border>
                      <TextBlock Text="Blur" FontSize="12" FontWeight="Medium" Margin="0,5,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="TrackPixelate" GroupName="TrackStyle" Style="{StaticResource HideTile}" Tag="Pixelate" Click="OnTrackStyle" AutomationProperties.Name="Pixelate"
                               ToolTip="Big pixels over the box, as many across a small box as a big one">
                    <StackPanel>
                      <Rectangle Width="22" Height="14" HorizontalAlignment="Center">
                        <Rectangle.Fill>
                          <DrawingBrush TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                              <DrawingGroup>
                                <GeometryDrawing Brush="#9AA1AE" Geometry="M0,0 H2 V2 H0 Z" />
                                <GeometryDrawing Brush="#6B7385" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                              </DrawingGroup>
                            </DrawingBrush.Drawing>
                          </DrawingBrush>
                        </Rectangle.Fill>
                      </Rectangle>
                      <TextBlock Text="Pixelate" FontSize="12" FontWeight="Medium" Margin="0,5,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="TrackSolid" GroupName="TrackStyle" Style="{StaticResource HideTile}" Tag="Solid" Click="OnTrackStyle" AutomationProperties.Name="Solid box"
                               ToolTip="The box filled with one color; the Edit view's inspector sets the color">
                    <StackPanel>
                      <Border Width="22" Height="14" CornerRadius="2" Background="Black" BorderBrush="#3A3F4B" BorderThickness="1" HorizontalAlignment="Center" />
                      <TextBlock Text="Solid box" FontSize="12" FontWeight="Medium" Margin="0,5,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                  </RadioButton>
                </UniformGrid>
                <Grid x:Name="TrackSliders" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Strength" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                  <Slider x:Name="TrackStrength" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                          VerticalAlignment="Center" Tag="strength" AutomationProperties.Name="Strength" ToolTip="0 to 100: bigger blocks, or more blur"
                          ValueChanged="OnTrackSliderMoved" PreviewMouseLeftButtonUp="OnTrackSliderReleased" KeyUp="OnTrackSliderKey" />
                  <TextBlock x:Name="TrackStrengthText" Grid.Column="2" TextAlignment="Right" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Text="Feather" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                  <Slider x:Name="TrackFeather" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                          VerticalAlignment="Center" Tag="feather" AutomationProperties.Name="Feather" ToolTip="A soft edge outside the box, in the footage's pixels"
                          ValueChanged="OnTrackSliderMoved" PreviewMouseLeftButtonUp="OnTrackSliderReleased" KeyUp="OnTrackSliderKey" />
                  <TextBlock x:Name="TrackFeatherText" Grid.Row="1" Grid.Column="2" TextAlignment="Right" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Text="Grow box" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                  <Slider x:Name="TrackGrow" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                          VerticalAlignment="Center" Tag="paddingPercent" AutomationProperties.Name="Grow box" ToolTip="Each side of a box grows by this share of its size, so the edges stay hidden"
                          ValueChanged="OnTrackSliderMoved" PreviewMouseLeftButtonUp="OnTrackSliderReleased" KeyUp="OnTrackSliderKey" />
                  <TextBlock x:Name="TrackGrowText" Grid.Row="2" Grid.Column="2" TextAlignment="Right" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <DockPanel Margin="0,0,0,16">
                  <TextBlock Text="Shape" Width="84" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                  <Border Background="{StaticResource InputBrush}" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="TrackRectangle" GroupName="TrackShape" Style="{StaticResource SegmentButton}" Content="Rectangle" Tag="rectangle" Checked="OnTrackShape"
                                   ToolTip="Hide the whole box" />
                      <RadioButton x:Name="TrackEllipse" GroupName="TrackShape" Style="{StaticResource SegmentButton}" Content="Ellipse" Tag="ellipse" Checked="OnTrackShape"
                                   ToolTip="Hide the ellipse inside the box, as for a face" />
                    </StackPanel>
                  </Border>
                </DockPanel>
                <DockPanel>
                  <CheckBox x:Name="TrackSmooth" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnTrackSmooth" AutomationProperties.Name="Smooth the motion"
                            ToolTip="The box's middle and size averaged over 6 frames each side, always holding the object's own box" />
                  <StackPanel>
                    <TextBlock Text="Smooth the motion" FontWeight="Medium" />
                    <TextBlock Text="Keeps the box steady through the tracker's jitter" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="36" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel TextElement.FontSize="12">
              <TextBlock x:Name="TrackTimecode" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tracking" FontWeight="SemiBold" FontSize="13" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Border Width="10" Height="6" CornerRadius="2" Background="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Tracked" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Border Width="10" Height="6" CornerRadius="2" Background="{StaticResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Lost or unsure" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Rectangle Width="8" Height="8" Fill="White" Margin="0,0,7,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <TextBlock Text="Set by hand" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </Border>
          <ScrollViewer MaxHeight="156" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <local:TrackStrip x:Name="TrackTimeline" Seek="OnTrackStripSeek" TrackChosen="OnTrackChosen"
                              ToolTip="Each object's time on the clip: click to go there, drag to scrub" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="AudioPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="140" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
          </Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Padding="16">
            <StackPanel Orientation="Horizontal">
              <ItemsControl x:Name="MixerStrips" Focusable="False" ItemTemplate="{StaticResource MixerStripTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Border Width="132" CornerRadius="12" Background="{StaticResource ChosenCardBrush}" BorderBrush="{StaticResource NoteBorderBrush}" BorderThickness="1" Padding="10">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="{StaticResource TextBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="Master" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <ItemsControl x:Name="MasterSlots" ItemTemplate="{StaticResource MixerSlotTemplate}" Focusable="False" Height="52" Margin="0,0,0,6" />
                  <TextBlock Text="Peak" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Height="16" Margin="0,0,0,10" />
                  <local:MixerMeter x:Name="MasterMeter" Height="220" ToolTip="The loudest of each side of the mix while it plays, in dBFS" />
                  <TextBlock x:Name="MasterPeak" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,10" />
                  <TextBlock Text="while playing" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Height="28" Padding="0,7,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="16">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Button x:Name="LoudnessTargetButton" DockPanel.Dock="Right" Style="{StaticResource FieldButton}" Height="26" Padding="10,0" FontSize="11" Click="OnLoudnessTarget"
                        ToolTip="The loudness every export is normalized to" />
                <TextBlock Text="Loudness" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <UniformGrid Columns="2" Margin="0,0,-8,0">
                <Border CornerRadius="10" Background="{StaticResource InputBrush}" Padding="12" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock x:Name="LoudnessLufs" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Integrated LUFS" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
                <Border CornerRadius="10" Background="{StaticResource InputBrush}" Padding="12" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock x:Name="LoudnessPeak" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Peak dBFS" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
              </UniformGrid>
              <Border CornerRadius="8" Background="{StaticResource NoteBrush}" BorderBrush="{StaticResource NoteBorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,10,0,0">
                <DockPanel>
                  <Button x:Name="MeasureButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Foreground="{StaticResource AccentSoftTextBrush}" Margin="10,0,0,0" VerticalAlignment="Top"
                          Click="OnMeasure" ToolTip="Mixes the sound as the export would and measures it, as audio_levels does">
                    <TextBlock x:Name="MeasureText" Text="Measure" FontSize="12" FontWeight="SemiBold" />
                  </Button>
                  <TextBlock x:Name="LoudnessText" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource AccentSoftTextBrush}" />
                </DockPanel>
              </Border>
              <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="#A98BFF" Margin="0,0,8,0" />
                <TextBlock Text="Music track" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <DockPanel Margin="0,0,0,14">
                <CheckBox x:Name="AutoDuck" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnAutoDuck" AutomationProperties.Name="Auto-duck" />
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Auto-duck under speech" FontWeight="Medium" />
                  <TextBlock Text="Lowers the music where voice clips play" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>
              <Grid x:Name="DuckSettings" TextElement.FontSize="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="32" />
                  <RowDefinition Height="32" />
                  <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <TextBlock Text="Duck by" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                <Slider x:Name="DuckLevelSlider" Grid.Column="1" Minimum="0" Maximum="40" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center" AutomationProperties.Name="Duck by"
                        ValueChanged="OnDuckSliderMoved" PreviewMouseLeftButtonDown="OnSliderPressed" PreviewMouseLeftButtonUp="OnDuckSliderReleased" KeyUp="OnDuckSliderKey"
                        ToolTip="How far the music goes down where voice plays, from 0 to 40 dB" />
                <TextBlock x:Name="DuckLevelText" Grid.Column="2" FontFamily="Consolas" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="Fade in" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                <Slider x:Name="DuckFadeInSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.5" VerticalAlignment="Center" AutomationProperties.Name="Duck fade in"
                        ValueChanged="OnDuckSliderMoved" PreviewMouseLeftButtonDown="OnSliderPressed" PreviewMouseLeftButtonUp="OnDuckSliderReleased" KeyUp="OnDuckSliderKey"
                        ToolTip="How long the music takes to go down before a voice clip starts" />
                <TextBlock x:Name="DuckFadeInText" Grid.Row="1" Grid.Column="2" FontFamily="Consolas" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="Fade out" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                <Slider x:Name="DuckFadeOutSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="5" SmallChange="0.05" LargeChange="0.5" VerticalAlignment="Center" AutomationProperties.Name="Duck fade out"
                        ValueChanged="OnDuckSliderMoved" PreviewMouseLeftButtonDown="OnSliderPressed" PreviewMouseLeftButtonUp="OnDuckSliderReleased" KeyUp="OnDuckSliderKey"
                        ToolTip="How long the music takes to come back up after a voice clip ends" />
                <TextBlock x:Name="DuckFadeOutText" Grid.Row="2" Grid.Column="2" FontFamily="Consolas" TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <DockPanel Grid.Row="1" Background="{StaticResource PanelBrush}">
        <Border DockPanel.Dock="Top" Height="40" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,0">
          <DockPanel>
            <TextBlock x:Name="AudioTimecode" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" />
            <Button x:Name="AudioPlayButton" DockPanel.Dock="Right" Style="{StaticResource HeaderIcon}" Margin="0,0,8,0" Click="OnPlay" ToolTip="Play (Space)" AutomationProperties.Name="Play">
              <local:Icon x:Name="AudioPlayIcon" Data="{StaticResource PlayShape}" Filled="True" Width="14" Height="14" />
            </Button>
            <TextBlock Text="Volume automation" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="Press a clip's line to add a point · drag a point to change its level · Delete removes it" Style="{StaticResource Secondary}" FontSize="12" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <local:VolumeView x:Name="VolumeLanes" Seek="OnSeek" Edit="OnTimelineEdit" LayerChosen="OnKeyLayer" />
      </DockPanel>
    </Grid>

    <Grid x:Name="CaptionsPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="420" />
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,20,24,24">
          <DockPanel>
            <ItemsControl x:Name="CaptionChips" DockPanel.Dock="Right" Focusable="False" ItemTemplate="{StaticResource CaptionChipTemplate}" VerticalAlignment="Center" Margin="12,0,0,-6">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="Captions" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <Border Background="{StaticResource NoteBrush}" BorderBrush="{StaticResource NoteBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
            <DockPanel>
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="14" Foreground="{StaticResource AccentSoftTextBrush}" Margin="0,1,12,0" VerticalAlignment="Top" />
              <TextBlock Foreground="{StaticResource AccentSoftTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                         Text="Edit any cell: a time you change applies to every language. To translate into a new language, ask Claude in your chat, such as &#x201C;add Thai captions&#x201D;." />
            </DockPanel>
          </Border>
          <Border x:Name="CaptionGridBox" Margin="0,16,0,0" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
            <StackPanel>
              <Border Background="{StaticResource PanelBrush}" CornerRadius="11,11,0,0">
                <Grid TextElement.Foreground="{StaticResource SecondaryTextBrush}" TextElement.FontSize="11" TextElement.FontWeight="SemiBold">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="#" Margin="14,10,0,10" />
                  <TextBlock Grid.Column="1" Text="TIME" Margin="12,10,0,10" />
                  <ItemsControl x:Name="CaptionHeadings" Grid.Column="2" Focusable="False" Margin="0,0,6,0" ItemTemplate="{StaticResource CaptionHeadingTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Grid>
              </Border>
              <ItemsControl x:Name="CaptionRows" Focusable="False" ItemTemplate="{StaticResource CaptionRowTemplate}" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="CaptionsEmpty" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,16,0,0" LineHeight="20" Visibility="Collapsed"
                     Text="This project has no captions yet. Import an .srt file, or ask Claude in your chat to make them from what is said (generate_captions) or to add a language (add_caption_track)." />
          <WrapPanel Margin="0,16,0,0">
            <Button x:Name="CaptionAdd" Padding="12,6" Margin="0,0,8,8" Click="OnAddCaption" ToolTip="A new caption at the playhead, or just after the caption the playhead is in">
              <StackPanel Orientation="Horizontal">
                <local:Icon Data="{StaticResource PlusShape}" Thickness="2" Width="11" Height="11" Margin="0,0,7,0" />
                <TextBlock Text="Add caption at playhead" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="CaptionImport" Content="Import .srt&#x2026;" FontWeight="Medium" Padding="12,6" Margin="0,0,8,8" Click="OnImportSrt"
                    ToolTip="A subtitle file as its language's caption track, as import_srt imports it" />
            <Button x:Name="CaptionSave" Content="Save .srt files" FontWeight="Medium" Padding="12,6" Margin="0,0,8,8" Click="OnSaveSrt"
                    ToolTip="Each track as an .srt file in the project's exports folder, as export_srt writes it" />
          </WrapPanel>
          <DockPanel x:Name="CaptionSavedPanel" Visibility="Collapsed" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Show in folder" Click="OnShowSrt" VerticalAlignment="Top" Margin="12,0,0,0" />
            <TextBlock x:Name="CaptionSaved" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" />
          </DockPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="20">
            <DockPanel>
              <Border x:Name="CaptionLanguageBar" DockPanel.Dock="Right" Background="{StaticResource InputBrush}" CornerRadius="7" Padding="2">
                <ItemsControl x:Name="CaptionLanguages" Focusable="False" ItemTemplate="{StaticResource PreviewLanguageTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Border>
              <TextBlock Text="Preview" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border Margin="0,12,0,0" CornerRadius="8" Background="{StaticResource PreviewBrush}" MinHeight="120">
              <Grid>
                <Image x:Name="CaptionPreview" Stretch="Uniform" MaxHeight="420" Source="{Binding Source, ElementName=PreviewImage}" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding Visibility, ElementName=PreviewImage}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Text, ElementName=PreviewMessage}" Visibility="{Binding Visibility, ElementName=PreviewMessage}"
                           TextWrapping="Wrap" TextTrimming="None" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock x:Name="CaptionPreviewText" Style="{StaticResource Secondary}" FontSize="11" Margin="0,8,0,0" />

            <TextBlock Text="STYLE &#x00B7; ALL CAPTIONS" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,24,0,12" />
            <Grid x:Name="CaptionStyle">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Font" Foreground="{StaticResource IconTextBrush}" Margin="0,8,0,0" VerticalAlignment="Top" />
              <ItemsControl x:Name="CaptionFonts" Grid.Column="1" Focusable="False" ItemTemplate="{StaticResource CaptionFontTemplate}" Margin="0,0,0,4" />

              <TextBlock Grid.Row="1" Text="Size" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
              <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,10">
                <TextBlock x:Name="CaptionSizeText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                <Slider x:Name="CaptionSize" Minimum="8" Maximum="120" SmallChange="1" LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" AutomationProperties.Name="Caption size"
                        ToolTip="The captions' font size, in pixels: the box and the outline grow with it" ValueChanged="OnCaptionSizeMoved"
                        PreviewMouseLeftButtonUp="OnCaptionSizeReleased" KeyUp="OnCaptionSizeKey" />
              </DockPanel>

              <TextBlock Grid.Row="2" Text="Position" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
              <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="7" Padding="2" HorizontalAlignment="Left" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="CaptionTop" GroupName="CaptionPlace" Style="{StaticResource SegmentButton}" Content="Top" Tag="Top" Padding="4,3" Checked="OnCaptionPlace"
                               ToolTip="At the top, inside the title-safe margin" />
                  <RadioButton x:Name="CaptionMiddle" GroupName="CaptionPlace" Style="{StaticResource SegmentButton}" Content="Middle" Tag="Middle" Checked="OnCaptionPlace"
                               ToolTip="In the middle of the frame" />
                  <RadioButton x:Name="CaptionBottom" GroupName="CaptionPlace" Style="{StaticResource SegmentButton}" Content="Bottom" Tag="Bottom" Checked="OnCaptionPlace"
                               ToolTip="At the bottom, inside the title-safe margin" />
                </StackPanel>
              </Border>

              <TextBlock Grid.Row="3" Text="Background" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="CaptionBox" GroupName="CaptionLook" Style="{StaticResource LookChoice}" Tag="Box" Checked="OnCaptionLook" ToolTip="A dark box behind the text"
                             AutomationProperties.Name="Box background">
                  <Border Background="Black" CornerRadius="3" Padding="6,1">
                    <TextBlock Text="Aa" FontSize="10" Foreground="White" />
                  </Border>
                </RadioButton>
                <RadioButton x:Name="CaptionOutline" GroupName="CaptionLook" Style="{StaticResource LookChoice}" Tag="Outline" Checked="OnCaptionLook" ToolTip="A black outline around the letters"
                             AutomationProperties.Name="Outline">
                  <TextBlock Text="Aa" FontSize="12" FontWeight="Bold">
                    <TextBlock.Effect>
                      <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="3" Opacity="1" />
                    </TextBlock.Effect>
                  </TextBlock>
                </RadioButton>
                <RadioButton x:Name="CaptionNone" GroupName="CaptionLook" Style="{StaticResource LookChoice}" Tag="None" Checked="OnCaptionLook" ToolTip="Nothing behind the text"
                             AutomationProperties.Name="No background">
                  <TextBlock Text="Aa" FontSize="12" />
                </RadioButton>
              </StackPanel>

              <TextBlock Grid.Row="4" Text="Max line" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
              <Grid Grid.Row="4" Grid.Column="1">
                <TextBox x:Name="CaptionWidth" Height="32" Padding="8,0,28,0" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Maximum line width"
                         ToolTip="How wide a line gets before it wraps, in pixels" PreviewKeyDown="OnCaptionWidthKey" LostKeyboardFocus="OnCaptionWidthLeft" />
                <TextBlock Style="{StaticResource BoxUnit}" Text="px" />
              </Grid>
            </Grid>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,14,0,0" LineHeight="18"
                       Text="Size, position, background and line width change every track's captions as one step; each track has its own font." />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <ScrollViewer x:Name="ActivityPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <Grid MaxWidth="1280" Margin="40,32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2"
                    VerticalAlignment="Bottom" Margin="16,0,0,0">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ActivityAll" GroupName="ActivityFilter" Style="{StaticResource SegmentButton}" Content="All" IsChecked="True" Checked="OnActivityFilter" />
                <RadioButton x:Name="ActivityYou" GroupName="ActivityFilter" Style="{StaticResource SegmentButton}" Content="You" Checked="OnActivityFilter" />
                <RadioButton x:Name="ActivityClaude" GroupName="ActivityFilter" Style="{StaticResource SegmentButton}" Content="Claude" Checked="OnActivityFilter" />
              </StackPanel>
            </Border>
            <StackPanel>
              <TextBlock Text="Activity" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                         Text="Every save by you and by Claude, grouped into steps. Restore puts a step back as a new save, so what it replaces stays here too." />
            </StackPanel>
          </DockPanel>
          <ItemsControl x:Name="ActivitySteps" Focusable="False" Margin="0,24,0,0" ItemTemplate="{StaticResource ActivityStepTemplate}" />
          <TextBlock x:Name="ActivityEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed" />
          <TextBlock x:Name="ActivityOlder" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="42,0,0,0"
                     Text="Older saves aren't kept: the backups folder keeps your last 20 and Claude's last 20." />
        </StackPanel>

        <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="14" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
          <StackPanel>
            <TextBlock Text="Try asking Claude" FontWeight="SemiBold" />
            <Border Style="{StaticResource AskExample}">
              <TextBlock Text="&#x201C;Add Japanese captions&#x201D;" Foreground="{StaticResource AccentSoftTextBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource AskExample}">
              <TextBlock Text="&#x201C;Cut the long pauses&#x201D;" Foreground="{StaticResource AccentSoftTextBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource AskExample}">
              <TextBlock Text="&#x201C;Blur every licence plate&#x201D;" Foreground="{StaticResource AccentSoftTextBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,0"
                       Text="Type these in your Claude chat: this app has no AI built in." />
            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,16" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" LineHeight="18"
                       Text="Each change you make here is saved as you make it, so Claude works on top of it on its next step, and what Claude changes shows here within a second. Undo here takes back only your own changes; Restore puts back any step." />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <ScrollViewer x:Name="ExportPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <Grid MaxWidth="1280" Margin="40,32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Export video" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0">
            <Run Text="Renders the project as it is saved now, the same as Claude's" />
            <Run Text="start_export" FontFamily="Consolas" Foreground="{StaticResource AccentSoftTextBrush}" /><Run Text=". Edits made while it runs aren't in it." />
          </TextBlock>
          <Grid Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="14" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="File name" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,0,0,6" />
              <TextBox x:Name="ExportName" Background="{StaticResource HeaderBrush}" FontWeight="Medium" Padding="12,9" ToolTip="The MP4's name in the project's exports folder" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Save to" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,0,0,6" />
              <Border Height="38" CornerRadius="8" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,0,4,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Show folder" Height="28" Padding="10,0" FontSize="12" Background="{StaticResource ChosenBrush}" BorderBrush="Transparent" VerticalAlignment="Center"
                          Click="OnShowExportsFolder" ToolTip="Open the exports folder in File Explorer; exports always go there, as start_export's do" />
                  <TextBlock x:Name="ExportFolder" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Grid>
          <TextBlock Text="PRESET" Style="{StaticResource PanelTitle}" Margin="0,28,0,10" />
          <ItemsControl x:Name="ExportPresets" Focusable="False" Margin="0,0,-10,0" ItemTemplate="{StaticResource PresetCardTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <StackPanel x:Name="ExportCaptionsSection" Margin="0,28,0,0">
            <TextBlock Text="LANGUAGE &amp; CAPTIONS" Style="{StaticResource PanelTitle}" Margin="0,0,0,10" />
            <Border CornerRadius="10" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
              <StackPanel>
                <DockPanel x:Name="ExportLanguageRow" Margin="14,12">
                  <Border DockPanel.Dock="Right" Background="{StaticResource InputBrush}" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                    <ItemsControl x:Name="ExportLanguages" Focusable="False" ItemTemplate="{StaticResource ChoiceTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </Border>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Language version" FontWeight="Medium" />
                    <TextBlock Text="Layers tagged with another language are left out" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
                <Border x:Name="ExportCaptionsDivider" Height="1" Background="{StaticResource DividerBrush}" />
                <DockPanel x:Name="ExportSrtRow" Margin="14,12">
                  <ItemsControl x:Name="ExportSubtitles" DockPanel.Dock="Right" Focusable="False" VerticalAlignment="Center" ItemTemplate="{StaticResource SrtChoiceTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Also save .srt files" FontWeight="Medium" />
                    <TextBlock Text="Upload these to YouTube as subtitle tracks" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock Text="FORMAT &amp; QUALITY" Style="{StaticResource PanelTitle}" Margin="0,28,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="10" />
              <ColumnDefinition />
              <ColumnDefinition Width="10" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Format" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,0,0,6" />
              <TextBlock Text="MP4 · H.264" FontWeight="Medium" Height="36" Padding="0,9,0,0" ToolTip="H.264 video and AAC sound in an MP4 file, as start_export makes them" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Quality" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,0,0,6" />
              <Button x:Name="QualityButton" Style="{StaticResource FieldButton}" Click="OnQualityMenu" ToolTip="How much the video is compressed: start_export's crf">
                <DockPanel>
                  <local:Icon DockPanel.Dock="Right" Data="{StaticResource ChevronDownShape}" Thickness="2.5" Width="10" Height="10" />
                  <TextBlock x:Name="QualityText" VerticalAlignment="Center" />
                </DockPanel>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border CornerRadius="14" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <Grid Height="190">
                <Border CornerRadius="13,13,0,0" Background="{StaticResource PictureBrush}" />
                <Border x:Name="ExportPicture" CornerRadius="13,13,0,0" />
                <Border Background="{StaticResource BadgeBrush}" CornerRadius="5" Padding="6,2" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <TextBlock x:Name="ExportLength" FontFamily="Consolas" FontSize="11" />
                </Border>
              </Grid>
              <StackPanel Margin="16">
                <Grid TextElement.FontSize="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Resolution" Foreground="{StaticResource SecondaryTextBrush}" />
                  <TextBlock x:Name="ExportResolution" Grid.Column="1" TextAlignment="Right" />
                  <TextBlock Grid.Row="1" Text="Frame rate" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" />
                  <TextBlock x:Name="ExportFps" Grid.Row="1" Grid.Column="1" TextAlignment="Right" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="2" Text="Duration" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" />
                  <TextBlock x:Name="ExportDuration" Grid.Row="2" Grid.Column="1" TextAlignment="Right" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="3" Text="Captions" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" />
                  <TextBlock x:Name="ExportCaptions" Grid.Row="3" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" Margin="16,8,0,0" />
                </Grid>
                <Button x:Name="ExportButton" Style="{StaticResource AccentButton}" Height="44" FontSize="14" Margin="0,16,0,0" Click="OnExport"
                        ToolTip="Export the project as it is saved now with these settings">
                  <StackPanel Orientation="Horizontal">
                    <local:Icon Data="{StaticResource ExportShape}" Thickness="2.2" Width="16" Height="16" />
                    <TextBlock x:Name="ExportButtonText" Text="Export" Margin="8,0,0,0" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ExportStatus" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <DockPanel Margin="0,20,0,8">
            <Button x:Name="QueueLink" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentSoftTextBrush}"
                    Click="OnRenderQueue" ToolTip="Your exports from every project, Claude's running ones, the render settings and the cache">
              <TextBlock x:Name="QueueLinkText" Text="Render queue" />
            </Button>
            <TextBlock Text="EXPORTS FOLDER" Style="{StaticResource PanelTitle}" />
          </DockPanel>
          <Border x:Name="OwnExport" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8"
                  Visibility="Collapsed">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="OwnExportStatus" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource AccentSoftTextBrush}" Margin="8,0,0,0" />
                <TextBlock x:Name="OwnExportName" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <ProgressBar x:Name="ExportProgress" Height="4" Maximum="100" Margin="0,8" />
              <DockPanel>
                <Button x:Name="StopExportButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Stop" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentHoverBrush}"
                        Click="OnStopExport" ToolTip="Stop this export; nothing is written to its file" />
                <TextBlock x:Name="OwnExportBy" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel>
          </Border>
          <ItemsControl x:Name="ExportClaude" Focusable="False" ItemTemplate="{StaticResource RunningExportCard}" />
          <ItemsControl x:Name="ExportFiles" Focusable="False" ItemTemplate="{StaticResource ExportFileCard}" />
          <TextBlock x:Name="ExportFilesEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"
                     Text="No exports yet." />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Grid x:Name="MediaPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="10,14">
            <TextBlock Text="LIBRARY" Style="{StaticResource PanelTitle}" Margin="8,0,8,8" />
            <StackPanel x:Name="LibraryShelves" />
            <DockPanel Margin="8,14,0,6">
              <Button x:Name="NewBinButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnNewBin" AutomationProperties.Name="New bin">
                <local:Icon Data="{StaticResource PlusShape}" Width="12" Height="12" Thickness="2.4" />
              </Button>
              <TextBlock Text="YOUR BINS" Style="{StaticResource PanelTitle}" />
            </DockPanel>
            <TextBox x:Name="NewBinBox" Margin="0,0,0,6" Padding="10,6" Visibility="Collapsed" KeyDown="OnNewBinKey" LostKeyboardFocus="OnNewBinLeft"
                     AutomationProperties.Name="New bin's name" ToolTip="The new bin's name. Enter puts the selected media in it; Esc leaves it" />
            <StackPanel x:Name="BinShelves" />
            <TextBlock x:Name="BinsEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="8,2,8,0"
                       Text="A bin is a tag. Select media, then New bin or + tag." />
            <Button x:Name="MissingCard" Margin="0,14,0,0" Click="OnBrowserRelink" Cursor="Hand" ToolTip="Find the missing files and point the project at them">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Bd" CornerRadius="8" Background="#2A1A1A" BorderBrush="#4A2626" BorderThickness="1" Padding="10">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="Relink" FontWeight="SemiBold" Foreground="#FFB4A8" TextDecorations="Underline" />
                      <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="#FFB4A8" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock x:Name="MissingText" Text="{TemplateBinding Content}" Foreground="#FFB4A8" />
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#341F1F" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <DockPanel Grid.Column="1" Margin="22,18,22,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="34" Padding="14,0" Margin="10,0,0,0" Click="OnImport" Content="Import"
                  ToolTip="Import images, audio, fonts or video (Ctrl+I)" />
          <Button x:Name="BrowserSortButton" DockPanel.Dock="Right" Style="{StaticResource FieldButton}" Height="34" Padding="12,0" FontSize="12" Margin="10,0,0,0" Click="OnBrowserSort"
                  ToolTip="The order of the media" />
          <Grid DockPanel.Dock="Right" Width="220" Height="34" Margin="10,0,0,0">
            <TextBox x:Name="BrowserSearch" Background="{StaticResource HeaderBrush}" Padding="30,7,8,0" FontSize="13" TextChanged="OnBrowserSearch"
                     AutomationProperties.Name="Search media" ToolTip="Show the media with these words in its name, its file's name or its tags" />
            <local:Icon Data="{StaticResource SearchShape}" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                        Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock x:Name="BrowserSearchHint" Text="Search name or tag" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{StaticResource SecondaryTextBrush}" />
          </Grid>
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run x:Name="BrowserTitle" FontSize="20" FontWeight="SemiBold" /><Run x:Name="BrowserCount" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
          </TextBlock>
        </DockPanel>
        <Grid>
          <ListBox x:Name="BrowserList" SelectionMode="Extended" SelectionChanged="OnBrowserSelected" MouseDoubleClick="OnBrowserOpened" MouseRightButtonUp="OnBrowserMenu"
                   SizeChanged="OnBrowserSized" ItemContainerStyle="{StaticResource MediaTile}" Padding="0,0,0,16" AutomationProperties.Name="Media">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Top" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel ToolTip="{Binding Tip}" Margin="2">
                  <Grid Height="120">
                    <Border x:Name="Frame" CornerRadius="7" Background="{StaticResource ControlBrush}" />
                    <local:Icon x:Name="SoundIcon" Data="{StaticResource MusicShape}" Width="26" Height="26" Foreground="#A98BFF" Visibility="Collapsed" />
                    <TextBlock x:Name="FontText" Text="Aa" FontSize="28" Foreground="{StaticResource IconTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <Border CornerRadius="7" Background="{Binding Picture}" />
                    <Border CornerRadius="4" Background="#CC0A0C10" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                      <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Badge}" />
                    </Border>
                    <Border x:Name="MetaBadge" CornerRadius="4" Background="#CC0A0C10" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                      <TextBlock Text="{Binding Meta}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <TextBlock x:Name="MissingText" Text="Missing" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                  </Grid>
                  <DockPanel Margin="2,7,2,2">
                    <TextBlock x:Name="UseText" DockPanel.Dock="Right" Text="{Binding Use}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Id}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="IMAGE">
                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource CheckerBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="AUDIO">
                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource SoundTileBrush}" />
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Kind}" Value="AUDIO" />
                      <Condition Binding="{Binding Picture}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SoundIcon" Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="FONT">
                    <Setter TargetName="FontText" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Meta}" Value="">
                    <Setter TargetName="MetaBadge" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="#2A1A1A" />
                    <Setter TargetName="UseText" Property="Foreground" Value="#FFB4A8" />
                    <Setter TargetName="MissingText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SoundIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FontText" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="BrowserEmpty" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="4,8" VerticalAlignment="Top"
                     Visibility="Collapsed" />
        </Grid>
      </DockPanel>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <Grid Margin="16">
          <DockPanel x:Name="BrowserDetails">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
              <Button x:Name="BrowserAddButton" Style="{StaticResource AccentButton}" Height="36" Content="Add at playhead" Click="OnBrowserAdd" Margin="0,0,0,8" />
              <Button x:Name="BrowserSourceButton" Height="36" Content="Open in source viewer" Click="OnBrowserSource" Margin="0,0,0,8" />
              <Button x:Name="BrowserFolderButton" Height="36" Content="Show in folder" Click="OnBrowserFolder" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <StackPanel>
                <Grid Height="200">
                  <Border x:Name="DetailFrame" CornerRadius="10" Background="{StaticResource ControlBrush}" />
                  <TextBlock x:Name="DetailFont" Text="Aa" FontSize="44" Foreground="{StaticResource IconTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="Collapsed" />
                  <Border x:Name="DetailPicture" CornerRadius="10" Margin="8" />
                </Grid>
                <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailSummary" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None" />
                <Grid x:Name="DetailRows" Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Used by" Style="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,8" />
                  <TextBlock x:Name="DetailUsedBy" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="1" Text="File size" Style="{StaticResource Secondary}" FontSize="12" Margin="0,0,0,8" />
                  <TextBlock x:Name="DetailSize" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="2" Text="Location" Style="{StaticResource Secondary}" FontSize="12" />
                  <TextBlock x:Name="DetailLocation" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="TAGS" Style="{StaticResource PanelTitle}" Margin="0,16,0,8" HorizontalAlignment="Left" />
                <WrapPanel x:Name="DetailTags" />
                <TextBox x:Name="TagBox" Margin="0,2,0,0" Padding="10,6" Visibility="Collapsed" KeyDown="OnTagKey" LostKeyboardFocus="OnTagLeft"
                         AutomationProperties.Name="New tag" ToolTip="A tag for the selected media. Enter adds it; Esc leaves it" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
          <TextBlock x:Name="BrowserNoSelection" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"
                     Text="Select media to see its details. Ctrl and Shift select several, to tag them together." />
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="SourcePage" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource DividerBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <DockPanel Background="{StaticResource PreviewBrush}">
        <Border DockPanel.Dock="Top" Height="40" BorderBrush="{StaticResource ControlBrush}" BorderThickness="0,0,0,1" Padding="14,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="4" Background="#3A2C14" Padding="7,2" VerticalAlignment="Center">
              <TextBlock Text="SOURCE" FontSize="11" FontWeight="Bold" Foreground="#F5C27A" />
            </Border>
            <TextBlock x:Name="SourceName" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SourceInfo" Style="{StaticResource Secondary}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom">
          <local:SourceScrubber x:Name="SourceScrubber" Margin="20,0,20,6" Seeked="OnSourceSeek" ToolTip="Press or drag to move through the file" />
          <DockPanel Margin="20,0">
            <TextBlock x:Name="SourceEnd" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock DockPanel.Dock="Left" Text="00:00.00" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock x:Name="SourceMarks" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="#F5C27A" />
          </DockPanel>
          <DockPanel Margin="20,12,20,16">
            <Button x:Name="SourceInsertButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="34" Margin="8,0,0,0" Click="OnSourceInsert"
                    ToolTip="Puts the part between the marks at the timeline's playhead and pushes what comes after it later (,)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Insert at playhead" />
                <TextBlock Text="," FontFamily="Consolas" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button x:Name="SourceOverwriteButton" DockPanel.Dock="Right" Height="34" Padding="12,0" Click="OnSourceOverwrite"
                    ToolTip="Puts the part between the marks at the timeline's playhead over what its lane has there (.)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Overwrite" />
                <TextBlock Text="." FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
              <Button Height="34" Padding="12,0" Click="OnMarkIn" ToolTip="The clip starts at this frame (I)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Mark in" />
                  <TextBlock Text="I" FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
              <Button Height="34" Padding="12,0" Margin="8,0,0,0" Click="OnMarkOut" ToolTip="The clip ends with this frame (O); Alt+X clears both marks">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Mark out" />
                  <TextBlock Text="O" FontFamily="Consolas" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0" />
                </StackPanel>
              </Button>
              <Button x:Name="SourcePlayButton" Style="{StaticResource RoundPlay}" Width="40" Height="40" Margin="10,0" Click="OnSourcePlay" ToolTip="Play the file (Space)"
                      AutomationProperties.Name="Play source">
                <local:Icon x:Name="SourcePlayIcon" Data="{StaticResource PlayShape}" Filled="True" Width="16" Height="16" />
              </Button>
              <Border x:Name="SourceTracks" CornerRadius="7" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2"
                      VerticalAlignment="Center">
                <ToggleButton x:Name="SourceAudio" Style="{StaticResource ToggleSegment}" Height="26" FontSize="11" FontWeight="SemiBold" Content="Audio" Click="OnSourceAudio"
                              AutomationProperties.Name="Use the sound" />
              </Border>
            </StackPanel>
          </DockPanel>
        </StackPanel>
        <Grid Margin="20">
          <Grid x:Name="SourceFrame" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="SourceImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border x:Name="SourceWave" CornerRadius="10" Background="{StaticResource SoundTileBrush}" Visibility="Collapsed">
              <Grid>
                <local:Icon x:Name="SourceWaveIcon" Data="{StaticResource MusicShape}" Width="40" Height="40" Foreground="#A98BFF" />
                <Border x:Name="SourceWavePicture" Margin="16" />
              </Grid>
            </Border>
            <Border CornerRadius="5" Background="#CC0A0C10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
              <TextBlock x:Name="SourceStamp" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}" />
            </Border>
          </Grid>
          <TextBlock x:Name="SourceMessage" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" TextWrapping="Wrap"
                     TextTrimming="None" />
        </Grid>
      </DockPanel>

      <DockPanel Grid.Column="2" Background="{StaticResource PreviewBrush}">
        <Border DockPanel.Dock="Top" Height="40" BorderBrush="{StaticResource ControlBrush}" BorderThickness="0,0,0,1" Padding="14,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="4" Background="{StaticResource AccentSoftBrush}" Padding="7,2" VerticalAlignment="Center">
              <TextBlock Text="PROGRAM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSoftTextBrush}" />
            </Border>
            <TextBlock x:Name="ProgramName" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ProgramTime" Style="{StaticResource Secondary}" FontFamily="Consolas" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="WHERE IT WILL GO · " Style="{StaticResource PanelTitle}" />
            <Button x:Name="SourceTargetButton" Style="{StaticResource LinkButton}" FontSize="11" FontWeight="SemiBold" Click="OnSourceTarget"
                    ToolTip="The lane the clip goes on: a draw level, or for a sound its role" />
          </StackPanel>
          <local:SourceStrip x:Name="SourceStrip" Margin="0,8,0,8" Seeked="OnSourceStripSeek" ToolTip="Press to move the timeline's playhead" />
          <TextBlock x:Name="SourceNote" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
        <Image x:Name="ProgramImage" Margin="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Source, ElementName=PreviewImage}" />
      </DockPanel>
    </Grid>

    <Grid x:Name="EffectsPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.RowSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="10,14">
          <TextBlock Text="CATEGORIES" Style="{StaticResource PanelTitle}" Margin="8,0,8,8" />
          <StackPanel x:Name="EffectCategories" />
        </StackPanel>
      </Border>

      <DockPanel Grid.Column="1" Margin="22,18,22,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid DockPanel.Dock="Right" Width="220" Height="34" Margin="10,0,0,0">
            <TextBox x:Name="EffectSearch" Background="{StaticResource HeaderBrush}" Padding="30,7,8,0" FontSize="13" TextChanged="OnEffectSearch"
                     AutomationProperties.Name="Search effects" ToolTip="Show the effects with these words in their name" />
            <local:Icon Data="{StaticResource SearchShape}" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                        Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock x:Name="EffectSearchHint" Text="Search effects" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{StaticResource SecondaryTextBrush}" />
          </Grid>
          <TextBlock x:Name="EffectsTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock x:Name="EffectsHint" DockPanel.Dock="Top" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,14" />
        <Grid>
          <ListBox x:Name="EffectList" SelectionChanged="OnEffectChosen" SizeChanged="OnEffectsSized" ItemContainerStyle="{StaticResource MediaTile}" Padding="0,0,0,16"
                   AutomationProperties.Name="Effects">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Top" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel ToolTip="{Binding Tip}" Margin="2" AutomationProperties.Name="{Binding Name}">
                  <local:EffectSketch Kind="{Binding Sketch}" Height="88" />
                  <DockPanel Margin="2,7,2,2">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EffectsEmpty" Style="{StaticResource Secondary}" FontSize="13" Margin="4,8" VerticalAlignment="Top" Visibility="Collapsed" Text="Nothing here has that name." />
        </Grid>
      </DockPanel>

      <Border x:Name="CutPanel" Grid.Row="1" Grid.Column="1" Padding="22,10,22,14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
          <TextBlock x:Name="CutTitle" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
          <local:CutStrip x:Name="CutStrip" Margin="0,8,0,0" Chosen="OnCutStripChosen" ToolTip="The cuts of the lane, marked; click a mark to choose that cut" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Grid.RowSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="EffectApplyButton" Style="{StaticResource AccentButton}" Height="36" Click="OnEffectApply" Margin="0,0,0,8" />
            <Button x:Name="EffectEveryButton" Height="36" Click="OnEffectEvery" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <TextBlock x:Name="EffectName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <Grid Height="162" Margin="0,12,0,0">
                <Border CornerRadius="10" Background="{StaticResource PreviewBrush}" />
                <Image x:Name="EffectPreview" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Source, ElementName=PreviewImage}" />
                <Border CornerRadius="4" Background="#CC0A0C10" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                  <TextBlock x:Name="EffectTarget" FontFamily="Consolas" FontSize="11" />
                </Border>
              </Grid>
              <Grid x:Name="TransitionSettings" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Duration" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                <DockPanel Grid.Column="1" Height="32">
                  <TextBlock DockPanel.Dock="Right" Text="s" Style="{StaticResource Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                  <TextBox x:Name="EffectDuration" Padding="10,0" VerticalContentAlignment="Center" FontFamily="Consolas" KeyDown="OnEffectDurationKey" LostKeyboardFocus="OnEffectDurationLeft"
                           AutomationProperties.Name="Duration in seconds" ToolTip="How long the transition takes, in seconds" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="Direction" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" Margin="0,10,0,0" />
                <WrapPanel x:Name="EffectDirections" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" />
              </Grid>
              <Border Background="{StaticResource NoteBrush}" BorderBrush="{StaticResource NoteBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                <TextBlock x:Name="EffectNote" Foreground="{StaticResource AccentSoftTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="ColorPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.Resources>
        <LinearGradientBrush x:Key="TemperatureTrack" StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#4B8BF0" Offset="0" />
          <GradientStop Color="#E8EAEE" Offset="0.5" />
          <GradientStop Color="#F0A94B" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TintTrack" StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#3DD68C" Offset="0" />
          <GradientStop Color="#E8EAEE" Offset="0.5" />
          <GradientStop Color="#E05BFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaturationTrack" StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#7C8392" Offset="0" />
          <GradientStop Color="#FF5D5D" Offset="1" />
        </LinearGradientBrush>
      </Grid.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="280" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <DockPanel Background="{StaticResource PreviewBrush}">
        <Border DockPanel.Dock="Top" Height="40" BorderBrush="{StaticResource MenuBrush}" BorderThickness="0,0,0,1" Padding="12,0">
          <DockPanel TextElement.FontSize="12">
            <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ColorAfter" GroupName="GradeViewMode" Style="{StaticResource SegmentButton}" Content="After" Tag="After" Checked="OnGradeViewMode"
                             ToolTip="The clip as graded, as it's exported" />
                <RadioButton x:Name="ColorSplit" GroupName="GradeViewMode" Style="{StaticResource SegmentButton}" Content="Split" Tag="Split" IsChecked="True" Checked="OnGradeViewMode"
                             ToolTip="The clip as shot left of the line and as graded right of it; drag to move the line" />
                <RadioButton x:Name="ColorBefore" GroupName="GradeViewMode" Style="{StaticResource SegmentButton}" Content="Before" Tag="Before" Checked="OnGradeViewMode"
                             ToolTip="The clip as shot, without its color changes" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ColorClipText" Foreground="{StaticResource TextBrush}" FontWeight="Medium" VerticalAlignment="Center" />
            <TextBlock x:Name="ColorNote" Foreground="{StaticResource SecondaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <local:GradeView x:Name="GradeViewer" Frame="{Binding Source, ElementName=PreviewImage}" RenderOptions.BitmapScalingMode="HighQuality" />
      </DockPanel>

      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <UniformGrid Columns="2" Margin="0,0,0,8">
              <Button x:Name="ColorCopy" Height="34" Margin="0,0,4,0" Content="Copy grade" Click="OnColorCopy" />
              <Button x:Name="ColorPaste" Height="34" Margin="4,0,0,0" Content="Paste grade" Click="OnColorPaste" />
            </UniformGrid>
            <Button x:Name="ColorApply" Style="{StaticResource AccentButton}" Height="34" Click="OnColorApply" />
          </StackPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button x:Name="ColorReset" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Foreground="{StaticResource AccentSoftTextBrush}" FontSize="12" FontWeight="Medium" Content="Reset all" Click="OnColorReset"
                    ToolTip="Put the clip's color back as shot: no grade, and contrast and saturation as they were" />
            <TextBlock Text="Adjust" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <Grid x:Name="ColorRows" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="92" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="58" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ColorExposureLabel" Grid.Row="0" Text="Exposure" Foreground="{StaticResource IconTextBrush}" Margin="0,0,0,0" VerticalAlignment="Center" />
            <Slider x:Name="ColorExposure" Grid.Row="0" Grid.Column="1" Tag="exposure" Style="{StaticResource CenteredSlider}" Minimum="-3" Maximum="3" SmallChange="0.1" LargeChange="0.5" TickFrequency="0.01" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    Margin="0,0,0,0" ValueChanged="OnColorSlider" PreviewMouseLeftButtonUp="OnColorSliderDone" KeyUp="OnColorSliderKey" AutomationProperties.Name="Exposure" />
            <TextBox x:Name="ColorExposureText" Grid.Row="0" Grid.Column="2" Tag="exposure" Margin="6,0,0,0" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                     FontFamily="Consolas" FontSize="12" TextAlignment="Right" VerticalContentAlignment="Center" KeyDown="OnColorReadoutKey" LostKeyboardFocus="OnColorReadoutLeft"
                     AutomationProperties.Name="Exposure value" />
            <TextBlock x:Name="ColorContrastLabel" Grid.Row="1" Text="Contrast" Foreground="{StaticResource IconTextBrush}" Margin="0,12,0,0" VerticalAlignment="Center" />
            <Slider x:Name="ColorContrast" Grid.Row="1" Grid.Column="1" Tag="contrast" Style="{StaticResource CenteredSlider}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    Margin="0,12,0,0" ValueChanged="OnColorSlider" PreviewMouseLeftButtonUp="OnColorSliderDone" KeyUp="OnColorSliderKey" AutomationProperties.Name="Contrast" />
            <TextBox x:Name="ColorContrastText" Grid.Row="1" Grid.Column="2" Tag="contrast" Margin="6,12,0,0" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                     FontFamily="Consolas" FontSize="12" TextAlignment="Right" VerticalContentAlignment="Center" KeyDown="OnColorReadoutKey" LostKeyboardFocus="OnColorReadoutLeft"
                     AutomationProperties.Name="Contrast value" />
            <TextBlock x:Name="ColorHighlightsLabel" Grid.Row="2" Text="Highlights" Foreground="{StaticResource IconTextBrush}" Margin="0,12,0,0" VerticalAlignment="Center" />
            <Slider x:Name="ColorHighlights" Grid.Row="2" Grid.Column="1" Tag="highlights" Style="{StaticResource CenteredSlider}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    Margin="0,12,0,0" ValueChanged="OnColorSlider" PreviewMouseLeftButtonUp="OnColorSliderDone" KeyUp="OnColorSliderKey" AutomationProperties.Name="Highlights" />
            <TextBox x:Name="ColorHighlightsText" Grid.Row="2" Grid.Column="2" Tag="highlights" Margin="6,12,0,0" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                     FontFamily="Consolas" FontSize="12" TextAlignment="Right" VerticalContentAlignment="Center" KeyDown="OnColorReadoutKey" LostKeyboardFocus="OnColorReadoutLeft"
                     AutomationProperties.Name="Highlights value" />
            <TextBlock x:Name="ColorShadowsLabel" Grid.Row="3" Text="Shadows" Foreground="{StaticResource IconTextBrush}" Margin="0,12,0,0" VerticalAlignment="Center" />
            <Slider x:Name="ColorShadows" Grid.Row="3" Grid.Column="1" Tag="shadows" Style="{StaticResource CenteredSlider}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    Margin="0,12,0,0" ValueChanged="OnColorSlider" PreviewMouseLeftButtonUp="OnColorSliderDone" KeyUp="OnColorSliderKey" AutomationProperties.Name="Shadows" />
            <TextBox x:Name="ColorShadowsText" Grid.Row="3" Grid.Column="2" Tag="shadows" Margin="6,12,0,0" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                     FontFamily="Consolas" FontSize="12" TextAlignment="Right" VerticalContentAlignment="Center" KeyDown="OnColorReadoutKey" LostKeyboardFocus="OnColorReadoutLeft"
                     AutomationProperties.Name="Shadows value" />
            <TextBlock x:Name="ColorTemperatureLabel" Grid.Row="4" Text="Temperature" Foreground="{StaticResource IconTextBrush}" Margin="0,12,0,0" VerticalAlignment="Center" />
            <Slider x:Name="ColorTemperature" Grid.Row="4" Grid.Column="1" Tag="temperature" Style="{StaticResource CenteredSlider}" Background="{StaticResource TemperatureTrack}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    Margin="0,12,0,0" ValueChanged="OnColorSlider" PreviewMouseLeftButtonUp="OnColorSliderDone" KeyUp="OnColorSliderKey" AutomationProperties.Name="Temperature" />
            <TextBox x:Name="ColorTemperatureText" Grid.Row="4" Grid.Column="2" Tag="temperature" Margin="6,12,0,0" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                     FontFamily="Consolas" FontSize="12" TextAlignment="Right" VerticalContentAlignment="Center" KeyDown="OnColorReadoutKey" LostKeyboardFocus="OnColorReadoutLeft"
                     AutomationProperties.Name="Temperature value" />
            <TextBlock x:Name="ColorTintLabel" Grid.Row="5" Text="Tint" Foreground="{StaticResource IconTextBrush}" Margin="0,12,0,0" VerticalAlignment="Center" />
            <Slider x:Name="ColorTint" Grid.Row="5" Grid.Column="1" Tag="tint" Style="{StaticResource CenteredSlider}" Background="{StaticResource TintTrack}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    Margin="0,12,0,0" ValueChanged="OnColorSlider" PreviewMouseLeftButtonUp="OnColorSliderDone" KeyUp="OnColorSliderKey" AutomationProperties.Name="Tint" />
            <TextBox x:Name="ColorTintText" Grid.Row="5" Grid.Column="2" Tag="tint" Margin="6,12,0,0" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                     FontFamily="Consolas" FontSize="12" TextAlignment="Right" VerticalContentAlignment="Center" KeyDown="OnColorReadoutKey" LostKeyboardFocus="OnColorReadoutLeft"
                     AutomationProperties.Name="Tint value" />
            <TextBlock x:Name="ColorSaturationLabel" Grid.Row="6" Text="Saturation" Foreground="{StaticResource IconTextBrush}" Margin="0,12,0,0" VerticalAlignment="Center" />
            <Slider x:Name="ColorSaturation" Grid.Row="6" Grid.Column="1" Tag="saturation" Style="{StaticResource CenteredSlider}" Background="{StaticResource SaturationTrack}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                    Margin="0,12,0,0" ValueChanged="OnColorSlider" PreviewMouseLeftButtonUp="OnColorSliderDone" KeyUp="OnColorSliderKey" AutomationProperties.Name="Saturation" />
            <TextBox x:Name="ColorSaturationText" Grid.Row="6" Grid.Column="2" Tag="saturation" Margin="6,12,0,0" Padding="4,2" Background="Transparent" BorderBrush="Transparent"
                     FontFamily="Consolas" FontSize="12" TextAlignment="Right" VerticalContentAlignment="Center" KeyDown="OnColorReadoutKey" LostKeyboardFocus="OnColorReadoutLeft"
                     AutomationProperties.Name="Saturation value" />
          </Grid>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14,24,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Waveform" FontWeight="SemiBold" Margin="0,0,0,6"
                       ToolTip="The frame's brightness, column by column: black at the bottom, white at the top" />
            <Border Height="150" CornerRadius="8" Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Border BorderBrush="#1E2128" BorderThickness="0,0,0,1" />
                <Border Grid.Row="1" BorderBrush="#1E2128" BorderThickness="0,0,0,1" />
                <Border Grid.Row="2" BorderBrush="#1E2128" BorderThickness="0,0,0,1" />
                <Image x:Name="WaveformImage" Grid.RowSpan="4" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
              </Grid>
            </Border>
          </DockPanel>
          <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Vectorscope" FontWeight="SemiBold" Margin="0,0,0,6"
                       ToolTip="The frame's colors by hue around the middle and by strength out from it; gray is in the middle" />
            <Grid Width="150" Height="150">
              <Ellipse Fill="{StaticResource PreviewBrush}" Stroke="{StaticResource DividerBrush}" StrokeThickness="1" />
              <Image x:Name="VectorscopeImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Clip>
                  <EllipseGeometry Center="75,75" RadiusX="74" RadiusY="74" />
                </Image.Clip>
              </Image>
              <Ellipse Width="4" Height="4" Fill="#5C6270" IsHitTestVisible="False" />
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="TitlesPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>

      <DockPanel Margin="24,20,24,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <Border DockPanel.Dock="Right" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="TitlesAll" GroupName="TitleFilter" Style="{StaticResource FilterChip}" Content="All" IsChecked="True" Checked="OnTitleFilter" Margin="0" />
              <RadioButton x:Name="TitlesStyles" GroupName="TitleFilter" Style="{StaticResource FilterChip}" Content="Your styles" Checked="OnTitleFilter" Margin="0" />
              <RadioButton x:Name="TitlesTemplates" GroupName="TitleFilter" Style="{StaticResource FilterChip}" Content="Templates" Checked="OnTitleFilter" Margin="0" />
            </StackPanel>
          </Border>
          <TextBlock Text="Titles" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="0,0,0,16">
            <StackPanel x:Name="StyleSection">
              <TextBlock Text="YOUR STYLES" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" HorizontalAlignment="Left" />
              <ListBox x:Name="StyleList" SelectionChanged="OnTitleCardChosen" SizeChanged="OnTitleCardsSized" ItemContainerStyle="{StaticResource MediaTile}"
                       ItemTemplate="{StaticResource TitleCardTemplate}" AutomationProperties.Name="Your styles">
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                  </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Top" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock x:Name="StylesEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="4,0,0,0" Visibility="Collapsed"
                         Text="No styles in the library yet. Ask Claude to save a text's look as a style (save_style)." />
            </StackPanel>
            <StackPanel x:Name="TemplateSection" Margin="0,22,0,0">
              <TextBlock Text="TEMPLATES" Style="{StaticResource PanelTitle}" Margin="0,0,0,8" HorizontalAlignment="Left" />
              <ListBox x:Name="TemplateList" SelectionChanged="OnTitleCardChosen" SizeChanged="OnTitleCardsSized" ItemContainerStyle="{StaticResource MediaTile}"
                       ItemTemplate="{StaticResource TitleCardTemplate}" AutomationProperties.Name="Templates">
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                  </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Top" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock x:Name="TemplatesEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="4,0,0,0" Visibility="Collapsed"
                         Text="No templates in the library yet. Ask Claude to save layers as a template (save_template): a lower third, a chapter card, an end screen." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="TitleAddButton" Style="{StaticResource AccentButton}" Height="36" Content="Add at playhead" Click="OnTitleAdd" Margin="0,0,0,8" />
            <Button x:Name="TitleApplyButton" Style="{StaticResource AccentButton}" Height="36" Click="OnTitleApply" Margin="0,0,0,8" />
            <Button x:Name="TitleUpdateButton" Height="36" Content="Update saved style" Click="OnTitleUpdate" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <DockPanel>
                <Button x:Name="TitleNewButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="New title" Click="OnTitleNew" FontSize="12" Margin="8,0,0,0"
                        ToolTip="Leave the selected text alone and set up a new title" />
                <TextBlock x:Name="TitleHeading" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="TitleSummary" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
              <StackPanel x:Name="TitleFields">
                <TextBlock Text="Line 1" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,14,0,6" />
                <TextBox x:Name="TitleLine1" Height="34" Padding="10,0" VerticalContentAlignment="Center" KeyDown="OnTitleFieldKey" LostKeyboardFocus="OnTitleFieldLeft"
                         AutomationProperties.Name="Line 1" />
                <TextBlock Text="Line 2" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,12,0,6" />
                <TextBox x:Name="TitleLine2" Height="34" Padding="10,0" VerticalContentAlignment="Center" KeyDown="OnTitleFieldKey" LostKeyboardFocus="OnTitleFieldLeft"
                         AutomationProperties.Name="Line 2" ToolTip="A second line under the first; empty for none" />
                <TextBlock Text="Colors" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,14,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <DockPanel ToolTip="The text's color: #RRGGBB, or #RRGGBBAA with opacity">
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0"
                            Background="{Binding Text, ElementName=TitleFill, Converter={StaticResource Swatch}}" />
                    <TextBox x:Name="TitleFill" Height="30" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas" KeyDown="OnTitleFieldKey" LostKeyboardFocus="OnTitleFieldLeft"
                             AutomationProperties.Name="Fill color" />
                  </DockPanel>
                  <DockPanel Grid.Column="2" ToolTip="The outline's color: #RRGGBB; empty for none">
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0"
                            Background="{Binding Text, ElementName=TitleOutline, Converter={StaticResource Swatch}}" />
                    <TextBox x:Name="TitleOutline" Height="30" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas" KeyDown="OnTitleFieldKey" LostKeyboardFocus="OnTitleFieldLeft"
                             AutomationProperties.Name="Outline color" />
                  </DockPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Animate in" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,0,0,6" />
                    <Button x:Name="TitleInButton" Style="{StaticResource FieldButton}" Height="34" Click="OnTitleIn" AutomationProperties.Name="Animate in"
                            ToolTip="How it comes in at its start: keyframes on its opacity, scale and position over half a second">
                      <DockPanel>
                        <local:Icon DockPanel.Dock="Right" Data="{StaticResource ChevronDownShape}" Thickness="2.5" Width="10" Height="10" />
                        <TextBlock x:Name="TitleInText" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Animate out" Foreground="{StaticResource IconTextBrush}" FontWeight="Medium" Margin="0,0,0,6" />
                    <Button x:Name="TitleOutButton" Style="{StaticResource FieldButton}" Height="34" Click="OnTitleOut" AutomationProperties.Name="Animate out"
                            ToolTip="How it goes out at its end: keyframes on its opacity, scale and position over half a second">
                      <DockPanel>
                        <local:Icon DockPanel.Dock="Right" Data="{StaticResource ChevronDownShape}" Thickness="2.5" Width="10" Height="10" />
                        <TextBlock x:Name="TitleOutText" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <Border Background="{StaticResource NoteBrush}" BorderBrush="{StaticResource NoteBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                <TextBlock x:Name="TitleNote" Foreground="{StaticResource AccentSoftTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="4" />
        <RowDefinition x:Name="TimelineRow" Height="260" MinHeight="120" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MediaColumn" Width="280" MinWidth="180" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="200" />
      </Grid.ColumnDefinitions>

      <DockPanel Background="{StaticResource PanelBrush}">
        <Border DockPanel.Dock="Left" Width="52" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
          <StackPanel Margin="0,8,0,0">
            <Button x:Name="MediaBrowserButton" Style="{StaticResource RailButton}" Click="OnMediaBrowser" AutomationProperties.Name="Open the media browser"
                         ToolTip="The media browser: bins, search, details and the source viewer">
              <StackPanel>
                <local:Icon Data="{StaticResource CardsShape}" Width="16" Height="16" />
                <TextBlock Text="Media" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="TitlesButton" Style="{StaticResource RailButton}" Click="OnTitlesView" AutomationProperties.Name="Open the titles"
                         ToolTip="Titles: the library's styles and templates, and a title's lines, colors and animation">
              <StackPanel>
                <local:Icon Data="{StaticResource TitleShape}" Width="16" Height="16" />
                <TextBlock Text="Titles" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="EffectsButton" Style="{StaticResource RailButton}" Click="OnEffectsView" AutomationProperties.Name="Open the effects"
                         ToolTip="Effects: transitions on cuts, video effects and how titles come in and go out">
              <StackPanel>
                <local:Icon Data="{StaticResource EffectsShape}" Width="16" Height="16" />
                <TextBlock Text="Effects" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ColorButton" Style="{StaticResource RailButton}" Click="OnColorView" AutomationProperties.Name="Open the color"
                         ToolTip="Color: a clip's exposure, contrast, white balance and saturation, before and after, with scopes">
              <StackPanel>
                <local:Icon Data="{StaticResource ColorShape}" Width="16" Height="16" />
                <TextBlock Text="Color" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Top" Margin="12,12,12,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Media" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5" Click="OnImport" ToolTip="Import images, audio, fonts or video (Ctrl+I)">
            <StackPanel Orientation="Horizontal">
              <local:Icon Data="{StaticResource PlusShape}" Width="12" Height="12" Thickness="2.4" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Import" />
            </StackPanel>
          </Button>
        </Grid>
        <WrapPanel x:Name="MediaFilters" DockPanel.Dock="Top" Margin="12,12,6,6">
          <RadioButton x:Name="AllFilter" GroupName="MediaFilter" Style="{StaticResource FilterChip}" Content="All" IsChecked="True" Checked="OnMediaFilter" />
          <RadioButton GroupName="MediaFilter" Style="{StaticResource FilterChip}" Content="Video" Tag="video" Checked="OnMediaFilter" />
          <RadioButton GroupName="MediaFilter" Style="{StaticResource FilterChip}" Content="Images" Tag="image" Checked="OnMediaFilter" />
          <RadioButton GroupName="MediaFilter" Style="{StaticResource FilterChip}" Content="Audio" Tag="audio" Checked="OnMediaFilter" />
          <RadioButton x:Name="FontsFilter" GroupName="MediaFilter" Style="{StaticResource FilterChip}" Content="Fonts" Tag="font" Checked="OnMediaFilter" Visibility="Collapsed" />
        </WrapPanel>
        <Grid DockPanel.Dock="Bottom" Margin="12,8,12,12">
          <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource ScrollThumbHoverBrush}" StrokeThickness="1" StrokeDashArray="4 3" />
          <TextBlock Text="Drop files here, or drag media onto the timeline" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None"
                     TextAlignment="Center" Margin="12" />
        </Grid>
        <ItemsControl x:Name="PendingList" DockPanel.Dock="Bottom" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StageText" Text="{Binding Stage}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding Normalizing, Converter={StaticResource Visible}}" />
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Stop normalizing" Click="OnCancelImport"
                          Visibility="{Binding Normalizing, Converter={StaticResource Visible}}" />
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Dismiss" Click="OnDismissImport"
                          Visibility="{Binding Failed, Converter={StaticResource Visible}}" />
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                  <Setter TargetName="StageText" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid>
          <ListBox x:Name="MediaList" SelectionChanged="OnMediaSelected" Padding="8,0" PreviewMouseLeftButtonDown="OnMediaPressed" PreviewMouseMove="OnMediaDragged"
                   MouseRightButtonUp="OnMediaMenu" MouseDoubleClick="OnMediaOpened" ItemContainerStyle="{StaticResource MediaTile}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" VerticalAlignment="Top" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel ToolTip="{Binding Tip}">
                  <Grid Height="72">
                    <Border x:Name="Frame" CornerRadius="8" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    <local:Icon x:Name="SoundIcon" Data="{StaticResource MusicShape}" Width="22" Height="22" Foreground="#A98BFF" Visibility="Collapsed" />
                    <TextBlock x:Name="FontText" Text="Aa" FontSize="20" Foreground="{StaticResource IconTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <Border CornerRadius="7" Margin="1" Background="{Binding Picture}" />
                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Badge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" />
                    <Border x:Name="LengthBadge" CornerRadius="4" Background="#CC0A0C10" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5">
                      <TextBlock Text="{Binding Length}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <TextBlock x:Name="MissingText" Text="Missing" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                  </Grid>
                  <TextBlock x:Name="NameText" Text="{Binding Id}" Margin="2,6,2,2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="AUDIO">
                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource SoundTileBrush}" />
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Kind}" Value="AUDIO" />
                      <Condition Binding="{Binding Picture}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SoundIcon" Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="FONT">
                    <Setter TargetName="FontText" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Length}" Value="{x:Null}">
                    <Setter TargetName="LengthBadge" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                    <Setter TargetName="MissingText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SoundIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FontText" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="MediaEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="16" VerticalAlignment="Top"
                     Text="No media yet. Import images, audio, fonts or video, or ask Claude to." Visibility="Collapsed" />
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

      <Grid Grid.Column="2" Background="{StaticResource PreviewBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource MenuBrush}" BorderThickness="0,0,0,1" Height="40" Padding="12,0,8,0">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Program" FontWeight="Medium" VerticalAlignment="Center" />
              <TextBlock x:Name="CanvasText" Style="{StaticResource Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="LanguageButton" Background="{StaticResource PanelBrush}" Padding="8,3" Margin="0,0,8,0" Click="OnLanguageMenu" Visibility="Collapsed"
                      ToolTip="The language whose version the preview shows, as an export in that language shows it">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="LanguageText" FontWeight="Medium" VerticalAlignment="Center" />
                  <local:Icon Data="{StaticResource ChevronDownShape}" Thickness="2.5" Width="10" Height="10" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
              <ToggleButton x:Name="SafeAreaToggle" Style="{StaticResource IconToggle}" Click="OnOverlay" AutomationProperties.Name="Safe area guides"
                            ToolTip="Safe area: the title-safe margin, and on a vertical canvas the strips the Shorts player covers, as check_project checks them">
                <local:Icon Data="{StaticResource SafeAreaShape}" Thickness="1.8" Width="15" Height="15" />
              </ToggleButton>
              <ToggleButton x:Name="GridToggle" Style="{StaticResource IconToggle}" Margin="4,0,0,0" Click="OnOverlay" AutomationProperties.Name="Grid overlay"
                            ToolTip="Thirds grid">
                <local:Icon Data="{StaticResource GridShape}" Thickness="1.8" Width="15" Height="15" />
              </ToggleButton>
              <Button x:Name="ZoomButton" Background="{StaticResource PanelBrush}" Padding="8,3" Margin="8,0,0,0" Click="OnZoomMenu" ToolTip="How big the frame is shown">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="ZoomText" FontWeight="Medium" VerticalAlignment="Center" />
                  <local:Icon Data="{StaticResource ChevronDownShape}" Thickness="2.5" Width="10" Height="10" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer x:Name="PreviewScroller" Grid.Row="1" Background="{StaticResource PreviewBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Focusable="False" SizeChanged="OnPreviewSizeChanged">
          <Grid MinWidth="{Binding ViewportWidth, ElementName=PreviewScroller}" MinHeight="{Binding ViewportHeight, ElementName=PreviewScroller}">
            <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                   MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove" MouseLeftButtonUp="OnPreviewMouseUp"
                   LostMouseCapture="OnPreviewLostCapture" SizeChanged="OnPreviewImageSized" />
            <Canvas Width="{Binding ActualWidth, ElementName=PreviewImage}" Height="{Binding ActualHeight, ElementName=PreviewImage}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="False">
              <Path x:Name="GridLines" Stroke="#40FFFFFF" StrokeThickness="1" Visibility="Collapsed" />
              <Rectangle x:Name="SafeAreaBox" Stroke="#59FFFFFF" StrokeThickness="1" StrokeDashArray="4 4" Visibility="Collapsed" />
              <Polygon x:Name="SelectionOutline" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" />
              <Ellipse x:Name="SelectionAnchor" Width="7" Height="7" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
            </Canvas>
          </Grid>
        </ScrollViewer>
        <TextBlock x:Name="PreviewMessage" Grid.Row="1" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="520" Margin="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
        <Border x:Name="PreviewBusy" Grid.Row="1" Background="#B0111114" CornerRadius="6" Padding="8,3" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
          <TextBlock Text="drawing…" Style="{StaticResource Secondary}" />
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource MenuBrush}" BorderThickness="0,1,0,0" MinHeight="52" Padding="16,4,10,4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="TimecodeText" FontFamily="Consolas" FontSize="14" Text="00:00:00:00" ToolTip="hours:minutes:seconds:frame" VerticalAlignment="Center" />
              <TextBlock x:Name="TotalText" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource DisabledTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                         ToolTip="The last frame" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource HeaderIcon}" ToolTip="First frame (Home)" AutomationProperties.Name="First frame" Click="OnFirstFrame">
                <local:Icon Data="{StaticResource FirstFrameShape}" />
              </Button>
              <Button Style="{StaticResource HeaderIcon}" ToolTip="Previous frame (Left; Shift+Left: 1 second)" AutomationProperties.Name="Previous frame" Click="OnPreviousFrame">
                <local:Icon Data="{StaticResource PreviousShape}" />
              </Button>
              <Button x:Name="PlayButton" Style="{StaticResource RoundPlay}" ToolTip="Play (Space)" AutomationProperties.Name="Play" Click="OnPlay">
                <local:Icon x:Name="PlayIcon" Data="{StaticResource PlayShape}" Filled="True" Width="18" Height="18" />
              </Button>
              <Button Style="{StaticResource HeaderIcon}" ToolTip="Next frame (Right; Shift+Right: 1 second)" AutomationProperties.Name="Next frame" Click="OnNextFrame">
                <local:Icon Data="{StaticResource NextShape}" />
              </Button>
              <Button Style="{StaticResource HeaderIcon}" ToolTip="Last frame (End)" AutomationProperties.Name="Last frame" Click="OnLastFrame">
                <local:Icon Data="{StaticResource LastFrameShape}" />
              </Button>
              <ToggleButton x:Name="LoopToggle" Style="{StaticResource IconToggle}" Width="32" Height="32" Margin="4,0,0,0" Click="OnLoop" AutomationProperties.Name="Loop"
                            ToolTip="Loop: play on from the start at the end">
                <local:Icon Data="{StaticResource LoopShape}" />
              </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="SoundText" Style="{StaticResource Secondary}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="220" />
              <TextBlock Text="Preview" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button x:Name="ScaleButton" Background="{StaticResource PanelBrush}" Padding="8,2" Click="OnScaleMenu"
                      ToolTip="The size frames are drawn at while playing; a paused frame is always drawn at the canvas size">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="ScaleText" FontWeight="Medium" VerticalAlignment="Center" />
                  <local:Icon Data="{StaticResource ChevronDownShape}" Thickness="2.5" Width="10" Height="10" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource HeaderIcon}" Width="28" Height="28" Margin="4,0,0,0" ToolTip="Full screen (F; Esc leaves)" AutomationProperties.Name="Full screen preview"
                      Click="OnFullScreen">
                <local:Icon Data="{StaticResource FullScreenShape}" Width="15" Height="15" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

      <DockPanel Grid.Column="4" Background="{StaticResource PanelBrush}">
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
          <StackPanel>
            <Grid Margin="14,12,8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border x:Name="InspectorBadge" CornerRadius="4" Padding="6,2" Margin="0,2,10,0" VerticalAlignment="Top">
                <TextBlock x:Name="InspectorKind" FontSize="10" FontWeight="SemiBold" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="InspectorName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InspectorDetails" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
              </StackPanel>
              <Button x:Name="InspectorMore" Grid.Column="2" Style="{StaticResource HeaderIcon}" Width="28" Height="28" VerticalAlignment="Top" Click="OnInspectorMenu"
                      ToolTip="Split, delete, hide or mute this clip" AutomationProperties.Name="More">
                <local:Icon Data="{StaticResource MoreShape}" Filled="True" Width="14" Height="14" />
              </Button>
            </Grid>
            <StackPanel x:Name="InspectorTabs" Orientation="Horizontal" Margin="8,8,8,0" />
            <Border x:Name="InspectorGap" Height="12" />
          </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl x:Name="InspectorList" Margin="14,0,10,12" Focusable="False" KeyboardNavigation.TabNavigation="Cycle"
                        ItemTemplateSelector="{StaticResource InspectorTemplates}" />
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

      <DockPanel Grid.Row="2" Grid.ColumnSpan="5" Background="{StaticResource PanelBrush}">
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Height="40">
          <Grid>
            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
              <Border Background="{StaticResource InputBrush}" CornerRadius="7" Padding="2">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="SelectTool" GroupName="Tool" Style="{StaticResource SegmentButton}" Width="30" Height="28" IsChecked="True" Checked="OnTool"
                               ToolTip="Select: click a clip to select it, drag it to move or trim it (V)" AutomationProperties.Name="Select tool">
                    <local:Icon Data="{StaticResource SelectShape}" Width="14" Height="14" />
                  </RadioButton>
                  <RadioButton x:Name="BladeTool" GroupName="Tool" Style="{StaticResource SegmentButton}" Width="30" Height="28" Checked="OnTool"
                               ToolTip="Blade: click a clip to split it there (B)" AutomationProperties.Name="Blade tool">
                    <local:Icon Data="{StaticResource BladeShape}" Width="14" Height="14" />
                  </RadioButton>
                </StackPanel>
              </Border>
              <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="8,0" />
              <Button x:Name="SplitButton" Style="{StaticResource HeaderIcon}" Width="30" Height="28" ToolTip="Split the selected clip at the playhead (S)" Click="OnSplit"
                      AutomationProperties.Name="Split">
                <local:Icon Data="{StaticResource SplitShape}" Width="14" Height="14" />
              </Button>
              <Button x:Name="DeleteButton" Style="{StaticResource HeaderIcon}" Width="30" Height="28" ToolTip="Delete the selected clip and its child layers (Delete)" Click="OnDelete"
                      AutomationProperties.Name="Delete">
                <local:Icon Data="{StaticResource DeleteShape}" Width="14" Height="14" />
              </Button>
              <Button x:Name="MarkerButton" Style="{StaticResource HeaderIcon}" Width="30" Height="28" ToolTip="Add a chapter marker at the playhead (M)" Click="OnAddMarker"
                      AutomationProperties.Name="Add marker">
                <local:Icon Data="{StaticResource MarkerShape}" Width="14" Height="14" />
              </Button>
              <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="8,0" />
              <ToggleButton x:Name="SnapToggle" Style="{StaticResource ToggleSegment}" Content="Snap" VerticalAlignment="Center"
                            ToolTip="Snap to clip edges, the playhead and markers (N)" Click="OnSnap" />
              <Button x:Name="PackButton" Content="Pack lanes" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnPackLanes"
                      ToolTipService.ShowOnDisabled="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="Speed" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Border Background="{StaticResource InputBrush}" CornerRadius="7" Padding="2" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                  <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="0.5×" Tag="0.5" Checked="OnSpeed" VerticalAlignment="Center" />
                  <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="1×" Tag="1" IsChecked="True" Checked="OnSpeed" VerticalAlignment="Center" />
                  <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="2×" Tag="2" Checked="OnSpeed" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button Style="{StaticResource HeaderIcon}" Width="28" Height="28" ToolTip="Zoom out (-)" Click="OnTimelineZoomOut" AutomationProperties.Name="Zoom out">
                <local:Icon Data="{StaticResource MinusShape}" Width="14" Height="14" />
              </Button>
              <Slider x:Name="ZoomSlider" Width="110" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="OnZoomSlider" ToolTip="Zoom (Ctrl+wheel)"
                      AutomationProperties.Name="Zoom" />
              <Button Style="{StaticResource HeaderIcon}" Width="28" Height="28" ToolTip="Zoom in (=)" Click="OnTimelineZoomIn" AutomationProperties.Name="Zoom in">
                <local:Icon Data="{StaticResource PlusShape}" Width="14" Height="14" />
              </Button>
              <Button Content="Fit" Padding="10,3" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="The whole project in view (Shift+Z)" Click="OnTimelineFit" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <local:TimelineView x:Name="Timeline" Seek="OnSeek" Selected="OnClipSelected" Edit="OnTimelineEdit" ClipMenu="OnClipMenu" ViewChanged="OnTimelineViewChanged"
                              LaneToggled="OnLaneToggled" CutChosen="OnCutChosen"
                              AllowDrop="True" DragOver="OnTimelineDragOver" DragLeave="OnTimelineDragLeave" Drop="OnTimelineDrop" />
          <ScrollBar x:Name="TimelineVertical" Grid.Column="1" Orientation="Vertical" Scroll="OnTimelineScroll" />
          <ScrollBar x:Name="TimelineHorizontal" Grid.Row="1" Orientation="Horizontal" Scroll="OnTimelineScroll" />
        </Grid>
      </DockPanel>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SelectionText" Style="{StaticResource Secondary}" MaxWidth="280" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
        <TextBlock x:Name="LayersText" Grid.Column="1" Style="{StaticResource Secondary}" Margin="0,0,16,0" />
        <TextBlock x:Name="SaveStatus" Grid.Column="2" Style="{StaticResource Secondary}" MaxWidth="560" Margin="0,0,16,0" Visibility="Collapsed" />
        <TextBlock x:Name="MessageText" Grid.Column="3" Style="{StaticResource Secondary}" Margin="0,0,16,0" />
        <TextBlock x:Name="JobsText" Grid.Column="4" Style="{StaticResource Secondary}" Margin="0,0,16,0" MaxWidth="420" />
        <TextBlock x:Name="FrameText" Grid.Column="5" Style="{StaticResource Secondary}" Margin="0,0,16,0" />
        <TextBlock x:Name="RenderText" Grid.Column="6" Style="{StaticResource Secondary}" />
      </Grid>
    </Border>

    <DockPanel x:Name="QueuePage" Grid.RowSpan="2" Background="{StaticResource WindowBrush}" Visibility="Collapsed">
      <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" MinHeight="48" Padding="12,0">
        <DockPanel>
          <Button x:Name="AddExportButton" DockPanel.Dock="Right" Style="{StaticResource FieldButton}" Height="32" Padding="12,0" VerticalAlignment="Center" Click="OnAddExport"
                  Content="+ Add export" ToolTip="Open the project's Export view to add an export to the queue" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource LogoButton}" Click="OnCloseAppPage" ToolTip="Back to where you were (Esc)" AutomationProperties.Name="Back" />
            <Button Style="{StaticResource LinkButton}" Content="ZeyoCut" FontSize="13" Margin="10,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" Click="OnCloseAppPage"
                    ToolTip="Back to where you were (Esc)" />
            <TextBlock Text="/" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="7,0" VerticalAlignment="Center" />
            <TextBlock Text="Render queue" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MaxWidth="1320" Margin="40,32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="340" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <DockPanel>
              <Button x:Name="PauseQueueButton" DockPanel.Dock="Right" Style="{StaticResource FieldButton}" Height="36" Padding="14,0" VerticalAlignment="Bottom" Margin="12,0,0,0" Click="OnPauseQueue">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="PauseQueueIcon" FontFamily="{StaticResource IconFont}" Text="&#xE769;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock x:Name="PauseQueueText" Text="Pause queue" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel>
                <TextBlock Text="Render queue" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" LineHeight="20" Margin="0,6,0,0"
                           Text="Your exports, from any project, run here one after another while you keep editing. Claude's exports run in its ZeyoCut server; they're listed while they run." />
              </StackPanel>
            </DockPanel>
            <Border x:Name="QueueListCard" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,1,1,0" Margin="0,18,0,0" ClipToBounds="True">
              <ItemsControl x:Name="QueueList" Focusable="False" ItemTemplate="{StaticResource QueueRowTemplate}" />
            </Border>
            <TextBlock x:Name="QueueEmpty" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,18,0,0" Visibility="Collapsed"
                       Text="Nothing is rendering. Exports you start in a project's Export view line up here." />
            <TextBlock x:Name="QueueNote" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
              <StackPanel>
                <TextBlock Text="While rendering" FontWeight="SemiBold" Margin="0,0,0,14" />
                <DockPanel Margin="0,0,0,14">
                  <CheckBox x:Name="GentleExports" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnRenderSetting"
                            AutomationProperties.Name="Keep editing smoothly" />
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Keep editing smoothly" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="Your exports render on one CPU thread, not several" />
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,14">
                  <CheckBox x:Name="GpuEncoder" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnRenderSetting"
                            AutomationProperties.Name="Use GPU encoder" />
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Use GPU encoder" />
                    <TextBlock x:Name="GpuEncoderNote" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="Faster when available; off, your exports use libx264" />
                  </StackPanel>
                </DockPanel>
                <DockPanel>
                  <CheckBox x:Name="NotifyExports" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnRenderSetting"
                            AutomationProperties.Name="Notify when done" />
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Notify when done" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="Flashes the taskbar button when the window isn't in front" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border x:Name="CacheCard" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,16,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock x:Name="CacheTotal" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource IconTextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Cache" FontWeight="SemiBold" />
                </DockPanel>
                <Border Height="8" CornerRadius="4" Background="{StaticResource BorderBrush}" ClipToBounds="True">
                  <Grid x:Name="CacheBar" />
                </Border>
                <ItemsControl x:Name="CacheLegend" Focusable="False" Margin="0,12,0,0" ItemTemplate="{StaticResource CacheLegendTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="CacheNote" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" Margin="0,4,0,12" />
                <Button x:Name="ClearCacheButton" Style="{StaticResource FieldButton}" Height="34" HorizontalContentAlignment="Center" Click="OnClearCache"
                        ToolTip="Delete the export chunks, preview sound, pictures and waveforms; each is made again when it's needed">
                  <TextBlock Text="Clear cache" HorizontalAlignment="Center" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DockPanel>

    <DockPanel x:Name="PrefsPage" Grid.RowSpan="2" Background="{StaticResource WindowBrush}" Visibility="Collapsed">
      <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" MinHeight="48" Padding="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource LogoButton}" Click="OnCloseAppPage" ToolTip="Back to where you were (Esc)" AutomationProperties.Name="Back" />
          <Button Style="{StaticResource LinkButton}" Content="ZeyoCut" FontSize="13" Margin="10,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" Click="OnCloseAppPage"
                  ToolTip="Back to where you were (Esc)" />
          <TextBlock Text="/" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="7,0" VerticalAlignment="Center" />
          <TextBlock Text="Preferences" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border DockPanel.Dock="Left" Width="240" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Padding="10,16">
        <StackPanel AutomationProperties.Name="Preference sections">
          <RadioButton x:Name="PrefsGeneral" Style="{StaticResource ShelfButton}" GroupName="PrefsSection" Content="General" FontWeight="Medium" IsChecked="True" Checked="OnPrefsSection" />
          <Button Style="{StaticResource NavButton}" FontWeight="Medium" Click="OnPrefsClaude" ToolTip="Open the Welcome view: how to connect Claude to ZeyoCut's MCP server">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Claude &amp; MCP" />
            </DockPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" FontWeight="Medium" Click="OnPrefsShortcuts" ToolTip="Open the list of keyboard shortcuts (Ctrl+/)">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Keyboard shortcuts" />
            </DockPanel>
          </Button>
          <RadioButton x:Name="PrefsExport" Style="{StaticResource ShelfButton}" GroupName="PrefsSection" Content="Export defaults" FontWeight="Medium" Checked="OnPrefsSection" />
          <Button Style="{StaticResource NavButton}" FontWeight="Medium" Click="OnPrefsCache" ToolTip="Open the Render queue's cache sizes and Clear cache">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Storage &amp; cache" />
            </DockPanel>
          </Button>
          <RadioButton x:Name="PrefsAbout" Style="{StaticResource ShelfButton}" GroupName="PrefsSection" Content="About" FontWeight="Medium" Checked="OnPrefsSection" />
        </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="48,32">
          <TextBlock x:Name="PrefsTitle" Text="General" FontSize="24" FontWeight="SemiBold" />
          <TextBlock x:Name="PrefsSubtitle" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                     Text="Changes save instantly and apply to every project." />

          <StackPanel x:Name="PrefsGeneralSection">
            <TextBlock Text="APP" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" />
            <Border CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}">
              <DockPanel Margin="16,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource FieldButton}" Height="32" Padding="14,0" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Content="Show folder"
                        Click="OnShowProjectsFolder" ToolTip="Open the projects folder in File Explorer" />
                <StackPanel>
                  <TextBlock Text="Projects folder" FontWeight="Medium" />
                  <TextBlock x:Name="PrefsFolder" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" LineHeight="18">
                    <Run Text="The editor and the MCP server share it. Change it with" />
                    <Run Text="ProjectsRoot" FontFamily="Consolas" Foreground="{StaticResource AccentSoftTextBrush}" />
                    <Run Text="in appsettings.json next to ZeyoCut.Mcp.exe, or the" />
                    <Run Text="ZEYOCUT_PROJECTS_DIR" FontFamily="Consolas" Foreground="{StaticResource AccentSoftTextBrush}" />
                    <Run Text="environment variable, then restart both." />
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </Border>

            <TextBlock Text="EDITING" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" />
            <Border CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}">
              <StackPanel>
                <DockPanel Margin="16,14">
                  <CheckBox x:Name="PrefsSnap" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnPrefsSnap" AutomationProperties.Name="Snap to clips and markers" />
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Snap to clips and markers" FontWeight="Medium" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="A clip you drag lines up with other clips' edges, markers and the playhead (N on the timeline)" />
                  </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{StaticResource DividerBrush}" />
                <DockPanel Margin="16,14">
                  <CheckBox x:Name="PrefsShowChanges" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnPrefsShowChanges"
                            AutomationProperties.Name="Show Claude's changes with a highlight" />
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Show Claude’s changes with a highlight" FontWeight="Medium" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="Clips Claude (or another program) just changed glow on the timeline for 3 seconds" />
                  </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{StaticResource DividerBrush}" />
                <DockPanel Margin="16,14">
                  <Grid DockPanel.Dock="Right" Width="90" Height="32" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBox x:Name="PrefsStill" Background="{StaticResource WindowBrush}" Padding="10,7,24,0" FontFamily="Consolas" FontSize="12"
                             AutomationProperties.Name="Seconds" ToolTip="Seconds, from 0.1 to 3600; Enter saves it" KeyDown="OnPrefsStillKey" LostKeyboardFocus="OnPrefsStillLeft" />
                    <TextBlock Text="s" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                               IsHitTestVisible="False" />
                  </Grid>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Default still-image length" FontWeight="Medium" />
                    <TextBlock x:Name="PrefsStillNote" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="How long a picture lasts when you add it to the timeline" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="PLAYBACK &amp; PERFORMANCE" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" />
            <Border CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}">
              <DockPanel Margin="16,14">
                <Border DockPanel.Dock="Right" Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal" AutomationProperties.Name="Preview quality">
                    <RadioButton x:Name="PrefsFull" GroupName="PrefsScale" Style="{StaticResource SegmentButton}" Content="Full" Tag="1" Padding="12,0" Height="28" Click="OnPrefsScale" />
                    <RadioButton x:Name="PrefsHalf" GroupName="PrefsScale" Style="{StaticResource SegmentButton}" Content="½" Tag="0.5" Padding="12,0" Height="28" Click="OnPrefsScale" />
                    <RadioButton x:Name="PrefsQuarter" GroupName="PrefsScale" Style="{StaticResource SegmentButton}" Content="¼" Tag="0.25" Padding="12,0" Height="28" Click="OnPrefsScale" />
                  </StackPanel>
                </Border>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Preview quality" FontWeight="Medium" />
                  <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                             Text="The size playback draws frames at; lower is smoother. The viewer's resolution menu is the same setting." />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PrefsExportSection" Visibility="Collapsed">
            <TextBlock Text="STARTS WITH" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" />
            <Border CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}">
              <StackPanel>
                <DockPanel Margin="16,14">
                  <Border DockPanel.Dock="Right" Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ItemsControl x:Name="PrefsPresets" Focusable="False" AutomationProperties.Name="Preset">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <RadioButton Style="{StaticResource SegmentButton}" GroupName="PrefsPreset" Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneTime}" ToolTip="{Binding Tip}"
                                       Tag="{Binding}" Padding="12,0" Height="28" Click="OnPrefsDefault" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Preset" FontWeight="Medium" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="A preset of another shape than a project's starts as Project settings there" />
                  </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{StaticResource DividerBrush}" />
                <DockPanel Margin="16,14">
                  <Border DockPanel.Dock="Right" Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ItemsControl x:Name="PrefsQualities" Focusable="False" AutomationProperties.Name="Quality">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <RadioButton Style="{StaticResource SegmentButton}" GroupName="PrefsQuality" Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneTime}" ToolTip="{Binding Tip}"
                                       Tag="{Binding}" Padding="12,0" Height="28" Click="OnPrefsDefault" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Quality" FontWeight="Medium" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="High is crf 18, Balanced 23 and Small 28, as start_export takes them" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PrefsAboutSection" Visibility="Collapsed">
            <Border CornerRadius="12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" Margin="0,28,0,0">
              <StackPanel Margin="16,14">
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource LogoButton}" IsEnabled="False" Focusable="False" />
                  <TextBlock x:Name="AboutVersion" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" Margin="0,12,0,0"
                           Text="ZeyoCut is open source under the MIT License. The libraries in it (SkiaSharp, OpenCvSharp, ONNX Runtime, the MCP SDK and others) are listed with their licenses in THIRD_PARTY_NOTICES.md, and their texts are in the licenses folder. FFmpeg isn't included: the editor runs the one on this computer." />
                <StackPanel x:Name="AboutFiles" Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="AboutLicense" Style="{StaticResource FieldButton}" Height="32" Padding="12,0" FontSize="12" Content="License" Click="OnAboutFile" ToolTip="Open LICENSE" />
                  <Button x:Name="AboutNotices" Style="{StaticResource FieldButton}" Height="32" Padding="12,0" FontSize="12" Margin="8,0,0,0" Content="Third-party notices" Click="OnAboutFile"
                          ToolTip="Open THIRD_PARTY_NOTICES.md" />
                  <Button x:Name="AboutLicenses" Style="{StaticResource FieldButton}" Height="32" Padding="12,0" FontSize="12" Margin="8,0,0,0" Content="Licenses folder" Click="OnAboutFile"
                          ToolTip="Open the licenses folder in File Explorer" />
                </StackPanel>
                <TextBlock x:Name="AboutMissing" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0" Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <Grid x:Name="DialogLayer" Grid.RowSpan="3" Background="#B80A0B0D" Visibility="Collapsed">
      <Border x:Name="ShortcutsDialog" Style="{StaticResource DialogCard}" MaxWidth="1040">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIcon}" Content="&#xE711;" ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="OnCloseDialog" Margin="8,0,0,0" />
              <Grid DockPanel.Dock="Right" Width="240" Height="34">
                <TextBox x:Name="ShortcutSearch" Background="{StaticResource InputBrush}" Padding="30,0,8,0" VerticalContentAlignment="Center" TextChanged="OnShortcutSearch"
                         AutomationProperties.Name="Search shortcuts" />
                <local:Icon Data="{StaticResource SearchShape}" Width="13" Height="13" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="ShortcutSearchHint" Text="Search actions or keys" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource SecondaryTextBrush}" />
              </Grid>
              <TextBlock Text="Keyboard shortcuts" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center">
              <Run Text="Press" />
              <InlineUIContainer BaselineAlignment="Center">
                <Border CornerRadius="5" Background="{StaticResource ChosenBrush}" Padding="6,1">
                  <TextBlock Text="?" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </Border>
              </InlineUIContainer>
              <Run Text="or F1 outside a text field to open this list." />
            </TextBlock>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,6">
              <ItemsControl x:Name="ShortcutGroups" ItemTemplate="{StaticResource ShortcutGroupTemplate}" Focusable="False" Margin="0,0,-32,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock x:Name="ShortcutsNone" Style="{StaticResource Secondary}" FontSize="13" Margin="0,0,0,14" Visibility="Collapsed" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border x:Name="NewProjectDialog" Style="{StaticResource DialogCard}" MaxWidth="860">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIcon}" Content="&#xE711;" ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="OnCloseDialog" />
              <TextBlock Text="New project" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <DockPanel>
              <Button x:Name="NewCreate" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Create project" Padding="16,9" Margin="10,0,0,0" Click="OnCreateProject" />
              <Button DockPanel.Dock="Right" Content="Cancel" Padding="16,8" Click="OnCloseDialog" />
              <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,12,0"
                         Text="Claude can also create projects: “make a new 9:16 project called short-01”." />
            </DockPanel>
          </Border>
          <Grid Margin="22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Name" Style="{StaticResource DialogLabel}" />
                  <TextBox x:Name="NewName" Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" KeyDown="OnNewProjectKey" AutomationProperties.Name="Project name" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Start from" Style="{StaticResource DialogLabel}" />
                  <Button x:Name="NewStartButton" Style="{StaticResource FieldButton}" Height="38" Padding="10,0" Click="OnNewStartMenu"
                          AutomationProperties.Name="Start from" ToolTip="A blank project, or a template from the library">
                    <DockPanel>
                      <local:Icon DockPanel.Dock="Right" Data="{StaticResource ChevronDownShape}" Thickness="2.5" Width="10" Height="10" Margin="8,0,0,0" />
                      <TextBlock x:Name="NewStartText" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <TextBlock Text="CANVAS" Style="{StaticResource PanelTitle}" FontSize="11" Margin="0,18,0,8" />
              <ItemsControl x:Name="NewCanvases" ItemTemplate="{StaticResource CanvasChoiceTemplate}" Focusable="False" Margin="0,0,-8,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="12" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="NewSizePanel">
                  <TextBlock Text="Size" Style="{StaticResource DialogLabel}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewWidth" Height="36" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="13" TextChanged="OnNewSize" AutomationProperties.Name="Width" />
                    <TextBlock Grid.Column="1" Text="×" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="NewHeight" Grid.Column="2" Height="36" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="13" TextChanged="OnNewSize" AutomationProperties.Name="Height" />
                  </Grid>
                </StackPanel>
                <StackPanel x:Name="NewFpsPanel" Grid.Column="2">
                  <TextBlock Text="Frame rate" Style="{StaticResource DialogLabel}" />
                  <Border Height="36" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <UniformGrid Columns="4">
                      <RadioButton x:Name="NewFps24" GroupName="NewFps" Style="{StaticResource SegmentButton}" Content="24" Tag="24" HorizontalContentAlignment="Center" Checked="OnNewChoice" />
                      <RadioButton x:Name="NewFps25" GroupName="NewFps" Style="{StaticResource SegmentButton}" Content="25" Tag="25" HorizontalContentAlignment="Center" Checked="OnNewChoice" />
                      <RadioButton x:Name="NewFps30" GroupName="NewFps" Style="{StaticResource SegmentButton}" Content="30" Tag="30" HorizontalContentAlignment="Center" Checked="OnNewChoice" />
                      <RadioButton x:Name="NewFps60" GroupName="NewFps" Style="{StaticResource SegmentButton}" Content="60" Tag="60" HorizontalContentAlignment="Center" Checked="OnNewChoice" />
                    </UniformGrid>
                  </Border>
                </StackPanel>
                <StackPanel x:Name="NewBackgroundPanel" Grid.Row="2">
                  <TextBlock Text="Background" Style="{StaticResource DialogLabel}" />
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NewBlack" GroupName="NewBackground" Style="{StaticResource SwatchChoice}" Background="#000000" Tag="#000000" ToolTip="Black" AutomationProperties.Name="Black" Checked="OnNewChoice" />
                    <RadioButton x:Name="NewWhite" GroupName="NewBackground" Style="{StaticResource SwatchChoice}" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="White" AutomationProperties.Name="White" Checked="OnNewChoice" />
                    <RadioButton x:Name="NewSky" GroupName="NewBackground" Style="{StaticResource SwatchChoice}" Background="#BFE3F7" Tag="#BFE3F7" ToolTip="Sky blue" AutomationProperties.Name="Sky blue" Checked="OnNewChoice" />
                    <RadioButton x:Name="NewTransparent" GroupName="NewBackground" Style="{StaticResource SwatchChoice}" Background="{StaticResource CheckerBrush}" Tag="#00000000"
                                 ToolTip="Transparent" AutomationProperties.Name="Transparent" Checked="OnNewChoice" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                  <TextBlock Text="Save in" Style="{StaticResource DialogLabel}" />
                  <Border Height="36" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0,4,0">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Show folder" Padding="8,2" FontSize="11" VerticalAlignment="Center" Click="OnShowProjectsFolder" ToolTip="Open the projects folder in File Explorer" />
                      <TextBlock x:Name="NewFolder" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="NewError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="PREVIEW" Style="{StaticResource PanelTitle}" FontSize="11" Margin="0,0,0,10" />
              <Border Height="250" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12">
                <Grid x:Name="NewPreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border x:Name="NewPreviewFill" BorderBrush="{StaticResource ScrollThumbHoverBrush}" BorderThickness="1" />
                  <Rectangle x:Name="NewPreviewSafe" Stroke="#4A5060" StrokeDashArray="4 3" StrokeThickness="1" />
                </Grid>
              </Border>
              <TextBlock x:Name="NewShape" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
              <TextBlock x:Name="NewExportNote" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,0" />
              <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="19" Text="You can change these later in Project settings." />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <Border x:Name="ImportSrtDialog" Style="{StaticResource DialogCard}" MaxWidth="520">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="22,16" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Cancel" Padding="16,8" Click="OnCloseDialog" />
              <Button x:Name="ImportSrtButton" Style="{StaticResource AccentButton}" Content="Import" Padding="16,9" Margin="10,0,0,0" Click="OnImportSrtChosen" />
            </StackPanel>
          </Border>
          <StackPanel Margin="22,22,22,0">
            <TextBlock x:Name="ImportSrtTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" LineHeight="20" Margin="0,6,0,16"
                       Text="Which language are its captions in? They become that language's track, in the subtitle style and the language's font." />
            <TextBlock Text="Language" Style="{StaticResource DialogLabel}" />
            <TextBox x:Name="ImportSrtLanguage" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" AutomationProperties.Name="Language"
                     TextChanged="OnImportSrtLanguage" KeyDown="OnImportSrtKey" />
            <TextBlock x:Name="ImportSrtNote" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" Margin="0,8,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border x:Name="RelinkDialog" Style="{StaticResource DialogCard}" MaxWidth="680">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="22,22,22,16">
            <Border Width="40" Height="40" CornerRadius="10" Background="#2A1A1A" Margin="0,0,14,0" VerticalAlignment="Top">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="18" Foreground="#FFB4A8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock x:Name="RelinkTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="RelinkSubtitle" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" LineHeight="20" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="22,16" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="RelinkCancel" Padding="16,8" Click="OnCloseDialog" />
              <Button x:Name="RelinkButton" Style="{StaticResource AccentButton}" Padding="16,9" Margin="10,0,0,0" Click="OnRelink" />
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460" Margin="22,0">
            <ItemsControl x:Name="RelinkList" ItemTemplate="{StaticResource MissingFileTemplate}" Focusable="False" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <DockPanel x:Name="WelcomePage" Grid.RowSpan="3" Background="{StaticResource WindowBrush}" Visibility="Collapsed">
      <DockPanel DockPanel.Dock="Top" Height="56" Margin="24,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Skip setup" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                Click="OnSkipWelcome" ToolTip="Go to your projects" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource LogoButton}" IsEnabled="False" Focusable="False" />
          <TextBlock Text="ZeyoCut" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid MaxWidth="1200" Margin="48,32,48,48">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="7*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Claude makes the cut.&#10;You fine-tune it." FontSize="40" FontWeight="ExtraBold" LineHeight="46" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="14" TextWrapping="Wrap" TextTrimming="None" LineHeight="22" MaxWidth="420" HorizontalAlignment="Left" Margin="0,14,0,28"
                       Text="ZeyoCut has no AI inside. Claude edits your projects through MCP, and this app shows every change the moment it lands." />
            <ItemsControl x:Name="WelcomeSteps" ItemTemplate="{StaticResource WelcomeStepTemplate}" Focusable="False" />
          </StackPanel>
          <Border Grid.Column="2" Background="{StaticResource DialogBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="28" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel>
                <Border x:Name="WelcomeStatus" DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="10,5">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="WelcomeStatusDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="WelcomeStatusText" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <TextBlock x:Name="WelcomeStepText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftTextBrush}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="WelcomeHeading" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0" />

              <StackPanel x:Name="WelcomeFolderStep" Margin="0,16,0,0">
                <TextBlock Foreground="{StaticResource IconTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22"
                           Text="Claude and the editor keep your projects in this folder:" />
                <Border Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,12,0,0">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Show folder" Padding="10,4" Click="OnShowProjectsFolder" ToolTip="Open the projects folder in File Explorer" />
                    <TextBlock x:Name="WelcomeFolder" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                  </DockPanel>
                </Border>
                <TextBlock Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" LineHeight="20" Margin="0,12,0,0"
                           Text="It's the ProjectsRoot setting in appsettings.json next to ZeyoCut.Mcp.exe, or the ZEYOCUT_PROJECTS_DIR environment variable; with the bundle, its Projects folder setting. The editor reads it from the same place." />
              </StackPanel>

              <StackPanel x:Name="WelcomeConnectStep" Margin="0,16,0,0">
                <TextBlock Foreground="{StaticResource IconTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="26">
                  <Run Text="1.  Open the Claude desktop app → Settings → Developer → Edit config." /><LineBreak />
                  <Run Text="2.  Paste the ZeyoCut server below into" /> <Run Text="mcpServers" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" /><Run Text="." /><LineBreak />
                  <Run Text="3.  Restart Claude. This screen turns green when it connects." />
                </TextBlock>
                <Border Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12" Margin="0,16,0,0">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource MenuBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                      <DockPanel>
                        <Button x:Name="WelcomeCopy" DockPanel.Dock="Right" Content="Copy" Padding="10,3" Click="OnCopyConfig" ToolTip="Copy the server's entry" />
                        <TextBlock Text="claude_desktop_config.json" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                    <TextBox x:Name="WelcomeConfig" IsReadOnly="True" BorderBrush="Transparent" Background="Transparent" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource IconTextBrush}"
                             Padding="12,10" TextWrapping="Wrap" AutomationProperties.Name="The server's entry for claude_desktop_config.json" />
                  </DockPanel>
                </Border>
                <TextBlock x:Name="WelcomeServerNote" Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                           Text="ZeyoCut.Mcp.exe isn't next to the editor: put the full path of yours in its place." />
                <TextBlock Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" LineHeight="20" Margin="0,10,0,0"
                           Text="With the ZeyoCut bundle (.mcpb), install it in Claude Desktop instead: Settings → Extensions → Advanced settings → Install Extension." />
                <TextBlock x:Name="WelcomeEarlier" Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0" Visibility="Collapsed" />
                <Border Background="#161A26" BorderBrush="#27304A" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="Then try asking Claude" FontWeight="SemiBold" FontSize="13" />
                    <WrapPanel Margin="0,8,0,0">
                      <Border Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <TextBlock Text="“Make a 10-second Short with Tora jumping”" FontSize="13" Foreground="{StaticResource AccentSoftTextBrush}" />
                      </Border>
                      <Border Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="10,6">
                        <TextBlock Text="“Add Japanese and Burmese captions”" FontSize="13" Foreground="{StaticResource AccentSoftTextBrush}" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="WelcomeSampleStep" Margin="0,16,0,0">
                <TextBlock x:Name="WelcomeSampleText" Foreground="{StaticResource IconTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22" />
              </StackPanel>

              <TextBlock x:Name="WelcomeError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
              <DockPanel Margin="0,24,0,0">
                <Button Style="{StaticResource LinkButton}" Content="I’ll do this later" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Click="OnSkipWelcome" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="WelcomeBack" Content="Back" Padding="16,10" Click="OnWelcomeBack" />
                  <Button x:Name="WelcomeNext" Style="{StaticResource AccentButton}" Padding="18,11" Margin="10,0,0,0" Click="OnWelcomeNext" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
