<Window x:Class="ZeyoCut.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeyoCut.Editor"
        Title="ZeyoCut Editor" Width="1400" Height="860" MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="ListButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <local:ColorSwatch x:Key="Swatch" />

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Margin" Value="0,0,14,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip" Value="{Binding Tip}" />
    </Style>

    <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Keyed}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <local:InspectorTemplates x:Key="InspectorTemplates">
      <local:InspectorTemplates.Section>
        <DataTemplate>
          <TextBlock Text="{Binding Label}" Style="{StaticResource PanelTitle}" Margin="0,14,0,4" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </local:InspectorTemplates.Section>
      <local:InspectorTemplates.Info>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Info>
      <local:InspectorTemplates.Number>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="KeyButton" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" GotKeyboardFocus="OnFieldEntered" />
            <TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource Secondary}" Margin="5,0,0,0" VerticalAlignment="Center" />
            <Button Grid.Column="3" Style="{StaticResource KeyButton}" Content="{Binding KeyGlyph}" ToolTip="{Binding KeyTip}" Tag="{Binding}" Click="OnToggleKeyframe"
                    Visibility="{Binding HasToggle, Converter={StaticResource Visible}}" />
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Number>
      <local:InspectorTemplates.Text>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="KeyButton" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" />
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Text>
      <local:InspectorTemplates.Color>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="KeyButton" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" />
            <Border Grid.Column="2" Width="16" Height="16" CornerRadius="3" Margin="5,0,0,0" BorderBrush="{StaticResource ScrollThumbHoverBrush}" BorderThickness="1"
                    Background="{Binding Value, Converter={StaticResource Swatch}}" HorizontalAlignment="Left" />
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Color>
      <local:InspectorTemplates.LongText>
        <DataTemplate>
          <StackPanel Margin="0,2">
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Value, Mode=OneTime}" Tag="{Binding}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto" ToolTip="{Binding Tip}" PreviewKeyDown="OnFieldKey" LostKeyboardFocus="OnFieldLeft" />
          </StackPanel>
        </DataTemplate>
      </local:InspectorTemplates.LongText>
      <local:InspectorTemplates.Toggle>
        <DataTemplate>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding IsOn, Mode=OneTime}" Tag="{Binding}" Click="OnFieldToggled" />
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Toggle>
      <local:InspectorTemplates.Choice>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Options}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding Name}" GroupName="{Binding Group}" IsChecked="{Binding Selected, Mode=OneTime}"
                               Tag="{Binding}" Click="OnFieldChosen" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </DataTemplate>
      </local:InspectorTemplates.Choice>
    </local:InspectorTemplates>

    <DataTemplate x:Key="ChoiceTemplate">
      <RadioButton x:Name="Choice" Style="{StaticResource SegmentButton}" Content="{Binding Name}" GroupName="{Binding Group}" IsChecked="{Binding Selected, Mode=OneTime}"
                   IsEnabled="{Binding Usable}" ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True" Tag="{Binding}" Click="OnPageChoice" />
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Usable}" Value="False">
          <Setter TargetName="Choice" Property="Opacity" Value="0.45" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ProjectTemplate">
      <Button Style="{StaticResource ListButton}" Click="OnOpenListed" Tag="{Binding Directory}">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
          <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
            <Run Text="{Binding Details, Mode=OneWay}" /><Run Text="{Binding Saved, Mode=OneWay, StringFormat=' · saved {0:yyyy-MM-dd HH:mm}'}" />
          </TextBlock>
          <TextBlock Text="{Binding Directory}" Style="{StaticResource Secondary}" Foreground="{StaticResource DisabledTextBrush}" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel x:Name="ModeBar" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Panel.ZIndex="1" Visibility="Collapsed">
      <RadioButton x:Name="AssistantMode" GroupName="Mode" Style="{StaticResource SegmentButton}" Content="Assistant" Checked="OnMode"
                   ToolTip="What Claude and you saved last, and how to work with Claude (Ctrl+1)" />
      <RadioButton x:Name="EditMode" GroupName="Mode" Style="{StaticResource SegmentButton}" Content="Edit" IsChecked="True" Checked="OnMode" ToolTip="The timeline, preview and inspector (Ctrl+2)" />
      <RadioButton x:Name="ExportMode" GroupName="Mode" Style="{StaticResource SegmentButton}" Content="Export" Checked="OnMode" ToolTip="Render the project to an MP4 (Ctrl+3)" />
    </StackPanel>

    <Menu>
      <MenuItem Header="_File">
        <MenuItem Header="_Open project…" InputGestureText="Ctrl+O" Click="OnOpen" />
        <MenuItem x:Name="RecentMenu" Header="Open _recent" SubmenuOpened="OnRecentOpened" />
        <MenuItem x:Name="CloseItem" Header="_Close project" Click="OnCloseProject" />
        <Separator />
        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoItem" Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndo" />
        <MenuItem x:Name="RedoItem" Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedo" />
        <Separator />
        <MenuItem x:Name="SplitItem" Header="_Split at playhead" InputGestureText="S" Click="OnSplit" />
        <MenuItem x:Name="DeleteItem" Header="_Delete" InputGestureText="Delete" Click="OnDelete" />
      </MenuItem>
      <MenuItem x:Name="MediaMenu" Header="_Media">
        <MenuItem Header="_Import…" InputGestureText="Ctrl+I" Click="OnImport" />
      </MenuItem>
    </Menu>

    <ScrollViewer x:Name="StartPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Width="720" Margin="32,48,32,32" HorizontalAlignment="Center">
        <TextBlock Text="ZeyoCut Editor" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,20"
                   Text="Open a project to see what Claude made and fine-tune it. Each change is saved as you make it, and Claude sees it on its next step." />
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource AccentButton}" Content="Open project folder…" Click="OnOpen" />
        </StackPanel>
        <TextBlock x:Name="StartError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="RecentTitle" Text="RECENT" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" />
        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource ProjectTemplate}" Focusable="False" />
        <TextBlock x:Name="ProjectsTitle" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" TextTrimming="CharacterEllipsis" />
        <ItemsControl x:Name="ProjectsList" ItemTemplate="{StaticResource ProjectTemplate}" Focusable="False" />
        <TextBlock x:Name="ProjectsEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="12,4,0,0" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="AssistantPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <StackPanel Width="720" Margin="32,40,32,32" HorizontalAlignment="Center">
        <TextBlock Text="Assistant" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="AssistantSaved" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
        <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="14,10" Margin="0,16,0,0">
          <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                     Text="Ask Claude in your chat to change this project, for example &#x201C;add Japanese captions&#x201D; or &#x201C;cut the long pauses&#x201D;. Each change you make here is saved as you make it, so Claude works on top of it on its next step; what Claude changes shows here within a second. Undo here takes back only your own changes." />
        </Border>
        <TextBlock Text="RECENT SAVES" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" />
        <ItemsControl x:Name="AssistantSaves" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                <Border x:Name="WhoBadge" Grid.Column="1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" Background="#6A4FB0">
                  <TextBlock Text="{Binding Who}" FontSize="11" Foreground="#FFFFFF" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Edit}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Edit}" />
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ByEditor}" Value="True">
                  <Setter TargetName="WhoBadge" Property="Background" Value="#2D6A9F" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="AssistantEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"
                   Text="Nothing saved yet since the project was made." />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="ExportPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
      <StackPanel Width="720" Margin="32,40,32,32" HorizontalAlignment="Center">
        <TextBlock Text="Export" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,18"
                   Text="Renders the project as it is saved now to an MP4 in its exports folder, as Claude's start_export does. Edits made while it runs aren't in it." />
        <Grid Grid.IsSharedSizeScope="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="File name" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
          <TextBox x:Name="ExportName" Grid.Column="1" Width="360" HorizontalAlignment="Left" ToolTip="Saved in the project's exports folder" />
          <TextBlock Grid.Row="1" Text="Preset" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,12,0,0" />
          <ItemsControl x:Name="ExportPresets" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Focusable="False" ItemTemplate="{StaticResource ChoiceTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock x:Name="ExportLanguageLabel" Grid.Row="2" Text="Language" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,12,0,0" />
          <ItemsControl x:Name="ExportLanguages" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Focusable="False" ItemTemplate="{StaticResource ChoiceTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <Button x:Name="ExportButton" Style="{StaticResource AccentButton}" Content="Export" Click="OnExport" />
          <Button x:Name="StopExportButton" Content="Stop" Margin="8,0,0,0" Click="OnStopExport" Visibility="Collapsed" />
          <Button x:Name="ShowExportButton" Content="Show in folder" Margin="8,0,0,0" Click="OnShowExport" Visibility="Collapsed" />
        </StackPanel>
        <ProgressBar x:Name="ExportProgress" Height="6" Maximum="100" Margin="0,16,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="ExportStatus" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Text="IN THE EXPORTS FOLDER" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" />
        <ItemsControl x:Name="ExportFiles" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource ListButton}" Click="OnShowExportFile" Tag="{Binding Path}" ToolTip="Show it in its folder">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ExportFilesEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"
                   Text="No exports yet." />
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="4" />
        <RowDefinition x:Name="TimelineRow" Height="260" MinHeight="120" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MediaColumn" Width="280" MinWidth="180" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="200" />
      </Grid.ColumnDefinitions>

      <DockPanel Background="{StaticResource PanelBrush}">
        <Grid DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Height="34">
          <TextBlock Text="MEDIA" Style="{StaticResource PanelTitle}" Margin="12,0" />
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Padding="10,3" Click="OnImport" ToolTip="Import images, audio, fonts or video (Ctrl+I)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Import" />
            </StackPanel>
          </Button>
        </Grid>
        <ItemsControl x:Name="PendingList" DockPanel.Dock="Bottom" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StageText" Text="{Binding Stage}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding Normalizing, Converter={StaticResource Visible}}" />
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Stop normalizing" Click="OnCancelImport"
                          Visibility="{Binding Normalizing, Converter={StaticResource Visible}}" />
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Dismiss" Click="OnDismissImport"
                          Visibility="{Binding Failed, Converter={StaticResource Visible}}" />
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                  <Setter TargetName="StageText" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid>
          <ListBox x:Name="MediaList" SelectionChanged="OnMediaSelected" Padding="0,4" PreviewMouseLeftButtonDown="OnMediaPressed" PreviewMouseMove="OnMediaDragged"
                   MouseRightButtonUp="OnMediaMenu" ToolTip="Drag onto the timeline to add it there; right-click to add it at the playhead">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="40" Height="22" CornerRadius="3" Background="{Binding Badge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsText" Text="{Binding Details}" Style="{StaticResource Secondary}" />
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter TargetName="DetailsText" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="MediaEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="16" VerticalAlignment="Top"
                     Text="No media yet. Import images, audio, fonts or video, or ask Claude to." Visibility="Collapsed" />
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="PreviewScroller" Background="{StaticResource PreviewBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Focusable="False" SizeChanged="OnPreviewSizeChanged">
          <Grid MinWidth="{Binding ViewportWidth, ElementName=PreviewScroller}" MinHeight="{Binding ViewportHeight, ElementName=PreviewScroller}">
            <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                   MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove" MouseLeftButtonUp="OnPreviewMouseUp"
                   LostMouseCapture="OnPreviewLostCapture" SizeChanged="OnPreviewImageSized" />
            <Canvas Width="{Binding ActualWidth, ElementName=PreviewImage}" Height="{Binding ActualHeight, ElementName=PreviewImage}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="False">
              <Polygon x:Name="SelectionOutline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
              <Ellipse x:Name="SelectionAnchor" Width="7" Height="7" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
            </Canvas>
          </Grid>
        </ScrollViewer>
        <TextBlock x:Name="PreviewMessage" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="520" Margin="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
        <Border x:Name="PreviewBusy" Background="#B0111114" CornerRadius="3" Padding="8,3" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
          <TextBlock Text="drawing…" Style="{StaticResource Secondary}" />
        </Border>

        <Border Grid.Row="1" Background="{StaticResource HeaderBrush}" Padding="6,3">
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="First frame (Home)" Click="OnFirstFrame" />
              <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous frame (Left; Shift+Left: 1 second)" Click="OnPreviousFrame" />
              <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="14" ToolTip="Play (Space)" Click="OnPlay" />
              <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next frame (Right; Shift+Right: 1 second)" Click="OnNextFrame" />
              <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Last frame (End)" Click="OnLastFrame" />
              <TextBlock x:Name="TimecodeText" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" Margin="12,0,10,0" Text="00:00:00:00" ToolTip="hours:minutes:seconds:frame" />
              <TextBlock x:Name="FrameText" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="SoundText" Style="{StaticResource Secondary}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="260" />
              <TextBlock x:Name="ZoomText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <RadioButton GroupName="Zoom" Style="{StaticResource SegmentButton}" Content="Fit" Tag="fit" IsChecked="True" Checked="OnZoom" ToolTip="As big as the panel allows" />
              <RadioButton GroupName="Zoom" Style="{StaticResource SegmentButton}" Content="50%" Tag="0.5" Checked="OnZoom" />
              <RadioButton GroupName="Zoom" Style="{StaticResource SegmentButton}" Content="100%" Tag="1" Checked="OnZoom" ToolTip="One pixel of the frame on one pixel of the screen" />
              <RadioButton GroupName="Zoom" Style="{StaticResource SegmentButton}" Content="200%" Tag="2" Checked="OnZoom" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

      <DockPanel Grid.Column="4" Background="{StaticResource PanelBrush}">
        <Grid DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Height="34">
          <TextBlock x:Name="InspectorTitle" Text="PROJECT" Style="{StaticResource PanelTitle}" Margin="12,0" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl x:Name="InspectorList" Margin="12,0,12,8" Grid.IsSharedSizeScope="True" Focusable="False" KeyboardNavigation.TabNavigation="Cycle"
                        ItemTemplateSelector="{StaticResource InspectorTemplates}" />
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

      <DockPanel Grid.Row="2" Grid.ColumnSpan="5" Background="{StaticResource PanelBrush}">
        <Grid DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Height="34">
          <StackPanel Orientation="Horizontal" Margin="6,0">
            <TextBlock Text="TIMELINE" Style="{StaticResource PanelTitle}" Margin="6,0,12,0" />
            <Button x:Name="SplitButton" Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Split the selected clip at the playhead (S)" Click="OnSplit" />
            <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete the selected clip and its child layers (Delete)" Click="OnDelete" />
            <ToggleButton x:Name="SnapToggle" Style="{StaticResource ToggleSegment}" Content="Snap" Margin="8,0,0,0" VerticalAlignment="Center"
                          ToolTip="Snap to clip edges, the playhead and markers" Click="OnSnap" />
            <Button x:Name="PackButton" Content="Pack lanes" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnPackLanes"
                    ToolTipService.ShowOnDisabled="True" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
            <TextBlock Text="Speed" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="0.5×" Tag="0.5" Checked="OnSpeed" VerticalAlignment="Center" />
            <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="1×" Tag="1" IsChecked="True" Checked="OnSpeed" VerticalAlignment="Center" />
            <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="2×" Tag="2" Checked="OnSpeed" VerticalAlignment="Center" />
            <TextBlock Text="Playback" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,4,0" />
            <RadioButton x:Name="FullScale" GroupName="Scale" Style="{StaticResource SegmentButton}" Content="Full" Tag="1" Checked="OnPlaybackScale" VerticalAlignment="Center"
                         ToolTip="Draw frames at the canvas size while playing" />
            <RadioButton x:Name="HalfScale" GroupName="Scale" Style="{StaticResource SegmentButton}" Content="½" Tag="0.5" Checked="OnPlaybackScale" VerticalAlignment="Center"
                         ToolTip="Draw frames at half the canvas size while playing; a paused frame is always full size" />
            <RadioButton x:Name="QuarterScale" GroupName="Scale" Style="{StaticResource SegmentButton}" Content="¼" Tag="0.25" Checked="OnPlaybackScale" VerticalAlignment="Center"
                         ToolTip="Draw frames at a quarter of the canvas size while playing; a paused frame is always full size" />
            <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Margin="16,0,0,0" ToolTip="Zoom out (-)" Click="OnTimelineZoomOut" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Zoom in (=)" Click="OnTimelineZoomIn" />
            <Button Content="Fit" Padding="10,2" VerticalAlignment="Center" ToolTip="The whole project in view (Shift+Z)" Click="OnTimelineFit" />
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <local:TimelineView x:Name="Timeline" Seek="OnSeek" Selected="OnClipSelected" Edit="OnTimelineEdit" ClipMenu="OnClipMenu" ViewChanged="OnTimelineViewChanged"
                              AllowDrop="True" DragOver="OnTimelineDragOver" DragLeave="OnTimelineDragLeave" Drop="OnTimelineDrop" />
          <ScrollBar x:Name="TimelineVertical" Grid.Column="1" Orientation="Vertical" Scroll="OnTimelineScroll" />
          <ScrollBar x:Name="TimelineHorizontal" Grid.Row="1" Orientation="Horizontal" Scroll="OnTimelineScroll" />
        </Grid>
      </DockPanel>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SaveStatus" Style="{StaticResource Secondary}" MaxWidth="560" />
        <TextBlock x:Name="MessageText" Grid.Column="1" Style="{StaticResource Secondary}" Margin="16,0" />
        <TextBlock x:Name="JobsText" Grid.Column="2" Style="{StaticResource Secondary}" Margin="0,0,16,0" MaxWidth="420" />
        <TextBlock x:Name="RenderText" Grid.Column="3" Style="{StaticResource Secondary}" />
      </Grid>
    </Border>
  </Grid>
</Window>
