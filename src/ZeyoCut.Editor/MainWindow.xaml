<Window x:Class="ZeyoCut.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeyoCut.Editor"
        Title="ZeyoCut Editor" Width="1400" Height="860" MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="ListButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="12,8">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ProjectTemplate">
      <Button Style="{StaticResource ListButton}" Click="OnOpenListed" Tag="{Binding Directory}">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
          <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
            <Run Text="{Binding Details, Mode=OneWay}" /><Run Text="{Binding Saved, Mode=OneWay, StringFormat=' · saved {0:yyyy-MM-dd HH:mm}'}" />
          </TextBlock>
          <TextBlock Text="{Binding Directory}" Style="{StaticResource Secondary}" Foreground="{StaticResource DisabledTextBrush}" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Menu>
      <MenuItem Header="_File">
        <MenuItem Header="_Open project…" InputGestureText="Ctrl+O" Click="OnOpen" />
        <MenuItem x:Name="RecentMenu" Header="Open _recent" />
        <MenuItem x:Name="CloseItem" Header="_Close project" Click="OnCloseProject" />
        <Separator />
        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoItem" Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndo" />
        <MenuItem x:Name="RedoItem" Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedo" />
        <Separator />
        <MenuItem x:Name="SplitItem" Header="_Split at playhead" InputGestureText="S" Click="OnSplit" />
        <MenuItem x:Name="DeleteItem" Header="_Delete" InputGestureText="Delete" Click="OnDelete" />
      </MenuItem>
      <MenuItem x:Name="MediaMenu" Header="_Media">
        <MenuItem Header="_Import…" InputGestureText="Ctrl+I" Click="OnImport" />
      </MenuItem>
    </Menu>

    <ScrollViewer x:Name="StartPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Width="720" Margin="32,48,32,32" HorizontalAlignment="Center">
        <TextBlock Text="ZeyoCut Editor" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,20"
                   Text="Open a project to see what Claude made and fine-tune it. Each change is saved as you make it, and Claude sees it on its next step." />
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource AccentButton}" Content="Open project folder…" Click="OnOpen" />
        </StackPanel>
        <TextBlock x:Name="StartError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="RecentTitle" Text="RECENT" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" />
        <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource ProjectTemplate}" Focusable="False" />
        <TextBlock x:Name="ProjectsTitle" Style="{StaticResource PanelTitle}" Margin="0,28,0,6" TextTrimming="CharacterEllipsis" />
        <ItemsControl x:Name="ProjectsList" ItemTemplate="{StaticResource ProjectTemplate}" Focusable="False" />
        <TextBlock x:Name="ProjectsEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="12,4,0,0" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>

    <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="4" />
        <RowDefinition x:Name="TimelineRow" Height="260" MinHeight="120" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MediaColumn" Width="280" MinWidth="180" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="200" />
      </Grid.ColumnDefinitions>

      <DockPanel Background="{StaticResource PanelBrush}">
        <Grid DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Height="34">
          <TextBlock Text="MEDIA" Style="{StaticResource PanelTitle}" Margin="12,0" />
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Padding="10,3" Click="OnImport" ToolTip="Import images, audio, fonts or video (Ctrl+I)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Import" />
            </StackPanel>
          </Button>
        </Grid>
        <ItemsControl x:Name="PendingList" DockPanel.Dock="Bottom" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StageText" Text="{Binding Stage}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding Normalizing, Converter={StaticResource Visible}}" />
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Stop normalizing" Click="OnCancelImport"
                          Visibility="{Binding Normalizing, Converter={StaticResource Visible}}" />
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Dismiss" Click="OnDismissImport"
                          Visibility="{Binding Failed, Converter={StaticResource Visible}}" />
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                  <Setter TargetName="StageText" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid>
          <ListBox x:Name="MediaList" SelectionChanged="OnMediaSelected" Padding="0,4">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="40" Height="22" CornerRadius="3" Background="{Binding Badge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsText" Text="{Binding Details}" Style="{StaticResource Secondary}" />
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter TargetName="DetailsText" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="MediaEmpty" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="16" VerticalAlignment="Top"
                     Text="No media yet. Import images, audio, fonts or video, or ask Claude to." Visibility="Collapsed" />
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="PreviewScroller" Background="{StaticResource PreviewBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Focusable="False" SizeChanged="OnPreviewSizeChanged">
          <Grid MinWidth="{Binding ViewportWidth, ElementName=PreviewScroller}" MinHeight="{Binding ViewportHeight, ElementName=PreviewScroller}">
            <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
        </ScrollViewer>
        <TextBlock x:Name="PreviewMessage" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="520" Margin="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
        <Border x:Name="PreviewBusy" Background="#B0111114" CornerRadius="3" Padding="8,3" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
          <TextBlock Text="drawing…" Style="{StaticResource Secondary}" />
        </Border>

        <Border Grid.Row="1" Background="{StaticResource HeaderBrush}" Padding="6,3">
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="First frame (Home)" Click="OnFirstFrame" />
              <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous frame (Left; Shift+Left: 1 second)" Click="OnPreviousFrame" />
              <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="14" ToolTip="Play (Space)" Click="OnPlay" />
              <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next frame (Right; Shift+Right: 1 second)" Click="OnNextFrame" />
              <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Last frame (End)" Click="OnLastFrame" />
              <TextBlock x:Name="TimecodeText" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" Margin="12,0,10,0" Text="00:00:00:00" ToolTip="hours:minutes:seconds:frame" />
              <TextBlock x:Name="FrameText" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="SoundText" Style="{StaticResource Secondary}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="260" />
              <TextBlock x:Name="ZoomText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <RadioButton GroupName="Zoom" Style="{StaticResource SegmentButton}" Content="Fit" Tag="fit" IsChecked="True" Checked="OnZoom" ToolTip="As big as the panel allows" />
              <RadioButton GroupName="Zoom" Style="{StaticResource SegmentButton}" Content="50%" Tag="0.5" Checked="OnZoom" />
              <RadioButton GroupName="Zoom" Style="{StaticResource SegmentButton}" Content="100%" Tag="1" Checked="OnZoom" ToolTip="One pixel of the frame on one pixel of the screen" />
              <RadioButton GroupName="Zoom" Style="{StaticResource SegmentButton}" Content="200%" Tag="2" Checked="OnZoom" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

      <DockPanel Grid.Column="4" Background="{StaticResource PanelBrush}">
        <Grid DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Height="34">
          <TextBlock x:Name="InspectorTitle" Text="PROJECT" Style="{StaticResource PanelTitle}" Margin="12,0" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl x:Name="InspectorList" Margin="12,8" Grid.IsSharedSizeScope="True" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Key}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,14,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

      <DockPanel Grid.Row="2" Grid.ColumnSpan="5" Background="{StaticResource PanelBrush}">
        <Grid DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Height="34">
          <StackPanel Orientation="Horizontal" Margin="6,0">
            <TextBlock Text="TIMELINE" Style="{StaticResource PanelTitle}" Margin="6,0,12,0" />
            <Button x:Name="SplitButton" Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Split the selected clip at the playhead (S)" Click="OnSplit" />
            <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete the selected clip and its child layers (Delete)" Click="OnDelete" />
            <ToggleButton x:Name="SnapToggle" Style="{StaticResource ToggleSegment}" Content="Snap" Margin="8,0,0,0" VerticalAlignment="Center"
                          ToolTip="Snap to clip edges, the playhead and markers" Click="OnSnap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
            <TextBlock Text="Speed" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="0.5×" Tag="0.5" Checked="OnSpeed" VerticalAlignment="Center" />
            <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="1×" Tag="1" IsChecked="True" Checked="OnSpeed" VerticalAlignment="Center" />
            <RadioButton GroupName="Speed" Style="{StaticResource SegmentButton}" Content="2×" Tag="2" Checked="OnSpeed" VerticalAlignment="Center" />
            <TextBlock Text="Playback" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,4,0" />
            <RadioButton x:Name="FullScale" GroupName="Scale" Style="{StaticResource SegmentButton}" Content="Full" Tag="1" Checked="OnPlaybackScale" VerticalAlignment="Center"
                         ToolTip="Draw frames at the canvas size while playing" />
            <RadioButton x:Name="HalfScale" GroupName="Scale" Style="{StaticResource SegmentButton}" Content="½" Tag="0.5" Checked="OnPlaybackScale" VerticalAlignment="Center"
                         ToolTip="Draw frames at half the canvas size while playing; a paused frame is always full size" />
            <RadioButton x:Name="QuarterScale" GroupName="Scale" Style="{StaticResource SegmentButton}" Content="¼" Tag="0.25" Checked="OnPlaybackScale" VerticalAlignment="Center"
                         ToolTip="Draw frames at a quarter of the canvas size while playing; a paused frame is always full size" />
            <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Margin="16,0,0,0" ToolTip="Zoom out (-)" Click="OnTimelineZoomOut" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Zoom in (=)" Click="OnTimelineZoomIn" />
            <Button Content="Fit" Padding="10,2" VerticalAlignment="Center" ToolTip="The whole project in view (Shift+Z)" Click="OnTimelineFit" />
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <local:TimelineView x:Name="Timeline" Seek="OnSeek" Selected="OnClipSelected" Edit="OnTimelineEdit" ClipMenu="OnClipMenu" ViewChanged="OnTimelineViewChanged" />
          <ScrollBar x:Name="TimelineVertical" Grid.Column="1" Orientation="Vertical" Scroll="OnTimelineScroll" />
          <ScrollBar x:Name="TimelineHorizontal" Grid.Row="1" Orientation="Horizontal" Scroll="OnTimelineScroll" />
        </Grid>
      </DockPanel>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SaveStatus" Style="{StaticResource Secondary}" MaxWidth="560" />
        <TextBlock x:Name="MessageText" Grid.Column="1" Style="{StaticResource Secondary}" Margin="16,0" />
        <TextBlock x:Name="JobsText" Grid.Column="2" Style="{StaticResource Secondary}" Margin="0,0,16,0" MaxWidth="420" />
        <TextBlock x:Name="RenderText" Grid.Column="3" Style="{StaticResource Secondary}" />
      </Grid>
    </Border>
  </Grid>
</Window>
